---
export interface Props {
  currentSlug?: string;
  categoryUrl?: string;
}

const { currentSlug = '', categoryUrl = '' } = Astro.props;

const cleanDisplayTitle = (raw: string) =>
  raw
    .replace(/Carbonzied/gi, 'Carbonized')
    .split('|')[0]
    .replace(/\s*:\s*$/g, '')
    .replace(/\s*:\s*/g, ' · ')
    .trim();

const cleanSummary = (raw: string) => {
  const s = raw
    .replace(/Carbonzied/gi, 'Carbonized')
    .replace(/,([^\s])/g, ', $1')
    .replace(/\s+/g, ' ')
    .trim();
  return s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
};

const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const nonEnglishPrefix = /^(fr|de|jp|es|it|ru|nl|pt|ko|ar)-/i;
const nonLatinChars = /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/;

const candidates = Object.values(productFiles)
  .map((p: any) => {
    const fm = p.frontmatter || {};
    const slug = String(fm.slug || '');
    const title = cleanDisplayTitle(String(fm.pageTitle || fm.title || ''));
    const summary = cleanSummary(String(fm.summary || fm.description || ''));
    const img = fm.thumb || fm.images?.[0]?.src || '';
    const dateVal = fm.date ? new Date(fm.date).getTime() : 0;
    const idVal = Number(fm.id) || 0;
    return {
      slug,
      title,
      summary,
      href: `/products/${slug}.html`,
      img,
      categoryUrl: String(fm.categoryUrl || ''),
      dateVal: Number.isNaN(dateVal) ? 0 : dateVal,
      idVal,
    };
  })
  .filter((item) =>
    item.slug &&
    item.slug !== currentSlug &&
    item.title &&
    item.img &&
    !item.slug.startsWith('product-type-') &&
    !nonEnglishPrefix.test(item.slug) &&
    !nonLatinChars.test(item.title)
  );

const sameCat = candidates
  .filter((item) => categoryUrl && item.categoryUrl === categoryUrl)
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal));

const otherCat = candidates
  .filter((item) => !categoryUrl || item.categoryUrl !== categoryUrl)
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal));

const relatedItems = [...sameCat, ...otherCat].slice(0, 8);
---
{relatedItems.length > 0 && (
    <section aria-label="Related products">
        <div class="bb-section-head" style="margin-bottom: 24px;">
            <div>
                <span class="bb-eyebrow">You May Also Like</span>
                <h2 class="bb-section-title" style="font-size: 24px;">Related Products</h2>
            </div>
            <div class="bb-carousel-controls">
                <button type="button" id="relatedPrev" class="bb-carousel-btn" aria-label="Previous related products">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button type="button" id="relatedNext" class="bb-carousel-btn" aria-label="Next related products">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>

        <div class="bb-carousel-viewport" id="relatedViewport">
            <div class="bb-carousel-track">
                {relatedItems.map((item) => (
                    <article class="bb-arrival-card">
                        <a href={item.href} class="bb-arrival-thumb">
                            <img
                                src={item.img}
                                width="480"
                                height="396"
                                alt={item.title}
                                loading="lazy"
                                decoding="async"
                            />
                        </a>
                        <div class="bb-arrival-body">
                            <h3 class="bb-arrival-title">
                                <a href={item.href}>{item.title}</a>
                            </h3>
                            {item.summary && (
                                <p class="bb-arrival-summary">{item.summary}</p>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
)}

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        var viewport = document.getElementById('relatedViewport');
        var prevBtn = document.getElementById('relatedPrev');
        var nextBtn = document.getElementById('relatedNext');
        if (!viewport || !prevBtn || !nextBtn) return;

        var scrollStep = function (dir) {
            var card = viewport.querySelector('.bb-arrival-card');
            var step = card ? (card.offsetWidth + 22) : 280;
            if (dir > 0 && viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 8) {
                viewport.scrollTo({ left: 0, behavior: 'smooth' });
            } else if (dir < 0 && viewport.scrollLeft <= 8) {
                viewport.scrollTo({ left: viewport.scrollWidth, behavior: 'smooth' });
            } else {
                viewport.scrollBy({ left: dir * step, behavior: 'smooth' });
            }
        };

        prevBtn.addEventListener('click', function () { scrollStep(-1); });
        nextBtn.addEventListener('click', function () { scrollStep(1); });
    });
</script>