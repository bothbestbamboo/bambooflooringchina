---
export interface Props {
  currentSlug?: string;
  categoryUrl?: string;
}

const { currentSlug = '', categoryUrl = '' } = Astro.props;

const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const nonEnglishPrefix = /^(fr|de|jp|es|it|ru|nl|pt|ko|ar)-/i;
const nonLatinChars = /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/;

const candidates = Object.values(productFiles)
  .map((p: any) => {
    const fm = p.frontmatter || {};
    const slug = String(fm.slug || '');
    const title = String(fm.pageTitle || fm.title || '').replace(/Carbonzied/gi, 'Carbonized');
    const summary = String(fm.summary || fm.description || '').replace(/Carbonzied/gi, 'Carbonized');
    const img = fm.thumb || fm.images?.[0]?.src || '';
    const dateVal = fm.date ? new Date(fm.date).getTime() : 0;
    const idVal = Number(fm.id) || 0;
    return {
      slug,
      title,
      summary,
      href: `/products/${slug}.html`,
      img,
      categoryUrl: String(fm.categoryUrl || ''),
      dateVal: Number.isNaN(dateVal) ? 0 : dateVal,
      idVal,
    };
  })
  .filter((item) =>
    item.slug &&
    item.slug !== currentSlug &&
    item.title &&
    item.img &&
    !item.slug.startsWith('product-type-') &&
    !nonEnglishPrefix.test(item.slug) &&
    !nonLatinChars.test(item.title)
  );

// 优先展示同分类产品，不足 8 个则用其他最新英文产品补齐
const sameCat = candidates
  .filter((item) => categoryUrl && item.categoryUrl === categoryUrl)
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal));

const otherCat = candidates
  .filter((item) => !categoryUrl || item.categoryUrl !== categoryUrl)
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal));

const relatedItems = [...sameCat, ...otherCat].slice(0, 8);
---
{relatedItems.length > 0 && (
    <section id="block-views-related-products" class="block block-views related-products-section">
        <div class="newest-header">
            <h2 class="section-heading">Related Products</h2>
            <div class="newest-controls">
                <button type="button" id="relatedPrev" class="prev-btn label" aria-label="Previous related products">
                    <i class="icon-chevron-left icon-white"></i>
                </button>
                <button type="button" id="relatedNext" class="next-btn label" aria-label="Next related products">
                    <i class="icon-chevron-right icon-white"></i>
                </button>
            </div>
        </div>
        <div class="newest-viewport" id="relatedViewport">
            <div class="newest-track">
                {relatedItems.map((item) => (
                    <article class="portfolioItem newest-card">
                        <a href={item.href} class="newest-thumb">
                            <img
                                src={item.img}
                                width="480"
                                height="396"
                                alt={item.title}
                                loading="lazy"
                                decoding="async"
                            />
                        </a>
                        <p class="newest-title">
                            <a href={item.href}>{item.title}</a>
                        </p>
                        {item.summary && (
                            <p class="related-summary">{item.summary}</p>
                        )}
                    </article>
                ))}
            </div>
        </div>
    </section>
)}

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        var viewport = document.getElementById('relatedViewport');
        var prevBtn = document.getElementById('relatedPrev');
        var nextBtn = document.getElementById('relatedNext');
        if (!viewport || !prevBtn || !nextBtn) return;

        var scrollStep = function (dir) {
            var card = viewport.querySelector('.newest-card');
            var step = card ? (card.offsetWidth + 16) : 260;
            if (dir > 0 && viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 8) {
                viewport.scrollTo({ left: 0, behavior: 'smooth' });
            } else if (dir < 0 && viewport.scrollLeft <= 8) {
                viewport.scrollTo({ left: viewport.scrollWidth, behavior: 'smooth' });
            } else {
                viewport.scrollBy({ left: dir * step, behavior: 'smooth' });
            }
        };

        prevBtn.addEventListener('click', function () { scrollStep(-1); });
        nextBtn.addEventListener('click', function () { scrollStep(1); });
    });
</script>