---
const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });
const sortedNews = Object.values(newsFiles).sort(
  (a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0)
);

// 自动取最新 10 篇作为 Hot，第 11~20 篇作为 Latest
const hotList = sortedNews.slice(0, 10).reverse();
const latestList = sortedNews.slice(10, 20);
---
<div class="sidebar-second span3 ">
    <div id="block-block-4" class="block block-block">
        <ul class="nav nav-tabs">
            <li class="active">
                <a href="#tab1" data-toggle="tab">Hot</a>
            </li>
            <li>
                <a href="#tab2" data-toggle="tab">Latest</a>
            </li>
        </ul>
        <div class="tab-content NewsSidebar">
            <div class="tab-pane" id="tab2">
                <ul>
                    {latestList.map((n: any) => {
                        const title = n.frontmatter.title || '';
                        return (
                            <li><a href={`/news/${n.frontmatter.slug}.html`}>{title.length > 28 ? title.slice(0, 28) + '...' : title}</a></li>
                        );
                    })}
                </ul>
            </div>
            <div class="tab-pane active" id="tab1">
                <ul>
                    {hotList.map((n: any) => {
                        const title = n.frontmatter.title || '';
                        return (
                            <li><a href={`/news/${n.frontmatter.slug}.html`}>{title.length > 28 ? title.slice(0, 28) + '...' : title}</a></li>
                        );
                    })}
                </ul>
            </div>
        </div>
    </div>

    <div id="block-views-mentor-slider-block-1" class="block block-views">
        <h3>Slider Block</h3>
        <div class="view view-mentor-slider view-id-mentor_slider view-display-id-block_1 slideWrap view-dom-id-2da00b99d51c37f5731cd96a81bc1428">
            <div class="view-content">
                <div>
                    <div class="peVolo">
                        <div data-delay="3"><img src="/img/UploadFiles/null-p193mhvg7f22014iq19v2ms0q721.jpg" alt="bamboo flooring" title="bamboo flooring" /></div>
                        <div data-delay="3"><img src="/img/UploadFiles/null-p19309fvqg34qar51bf011p91oem1.jpg" alt="bamboo flooring" title="bamboo flooring" /></div>
                        <div data-delay="3"><img src="/img/UploadFiles/null-p19309fhc31k4nktq13pslkq4dt1.jpg" alt="bamboo flooring" title="bamboo flooring" /></div>
                        <div data-delay="3"><img src="/img/UploadFiles/null-p19309a3at1mv41p8op4onkkupe1.jpg" alt="bamboo flooring" title="bamboo flooring" /></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>