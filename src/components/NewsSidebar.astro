---
const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });
const sortedNews = Object.values(newsFiles).sort(
  (a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0)
);

const latestList = sortedNews.slice(0, 10);
const hotList = sortedNews.slice(10, 20);

const sidebarSlides = [
  { src: '/img/UploadFiles/null-p193mhvg7f22014iq19v2ms0q721.jpg', alt: 'Bothbest solid bamboo flooring showcase' },
  { src: '/img/UploadFiles/null-p19309fvqg34qar51bf011p91oem1.jpg', alt: 'Strand woven bamboo flooring planks' },
  { src: '/img/UploadFiles/null-p19309fhc31k4nktq13pslkq4dt1.jpg', alt: 'Carbonized bamboo flooring interior' },
  { src: '/img/UploadFiles/null-p19309a3at1mv41p8op4onkkupe1.jpg', alt: 'Wholesale China bamboo flooring factory' },
];
---
<aside class="bb-sidebar" aria-label="News sidebar">
    <div class="bb-sidebar-card">
        <div class="bb-tab-bar" id="newsSidebarTabs" role="tablist">
            <button type="button" class="bb-tab-btn is-active" data-tab-target="tab-latest" role="tab" aria-selected="true">Latest Guides</button>
            <button type="button" class="bb-tab-btn" data-tab-target="tab-hot" role="tab" aria-selected="false">Popular</button>
        </div>
        <div class="bb-tab-panel is-active" id="tab-latest" role="tabpanel">
            <ul class="bb-sidebar-list">
                {latestList.map((n: any, idx: number) => {
                    const title = n.frontmatter.title || '';
                    return (
                        <li>
                            <a href={`/news/${n.frontmatter.slug}.html`} title={title}>
                                <span class="bb-sidebar-num">{String(idx + 1).padStart(2, '0')}</span>
                                <span>{title}</span>
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>
        <div class="bb-tab-panel" id="tab-hot" role="tabpanel">
            <ul class="bb-sidebar-list">
                {hotList.map((n: any, idx: number) => {
                    const title = n.frontmatter.title || '';
                    return (
                        <li>
                            <a href={`/news/${n.frontmatter.slug}.html`} title={title}>
                                <span class="bb-sidebar-num">{String(idx + 1).padStart(2, '0')}</span>
                                <span>{title}</span>
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>
    </div>

    <div class="bb-sidebar-card">
        <h3 class="bb-sidebar-title">Bamboo Showcase</h3>
        <div class="bb-slider" id="sidebarSlider" aria-roledescription="carousel" aria-label="Bamboo Showcase">
            <div class="bb-slides">
                {sidebarSlides.map((slide, idx) => (
                    <div class={`bb-slide${idx === 0 ? ' is-active' : ''}`}>
                        <img
                            src={slide.src}
                            alt={slide.alt}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                ))}
            </div>
            <button type="button" class="bb-slider-btn bb-slider-prev" id="sidebarPrev" aria-label="Previous image" style="width: 30px; height: 30px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" class="bb-slider-btn bb-slider-next" id="sidebarNext" aria-label="Next image" style="width: 30px; height: 30px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <div class="bb-slider-dots" id="sidebarDots">
                {sidebarSlides.map((_, idx) => (
                    <button
                        type="button"
                        class={`bb-slider-dot${idx === 0 ? ' is-active' : ''}`}
                        data-slide={idx}
                        aria-label={`View image ${idx + 1}`}
                    ></button>
                ))}
            </div>
        </div>
    </div>

    <div class="bb-sidebar-cta">
        <h3>Need Wholesale Samples?</h3>
        <p>Request free bamboo flooring, decking, or panel samples directly from our Anji factory.</p>
        <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary" style="width: 100%;">Request a Quote</a>
    </div>
</aside>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        var tabBar = document.getElementById('newsSidebarTabs');
        if (tabBar) {
            tabBar.addEventListener('click', function (e) {
                var btn = e.target.closest('button[data-tab-target]');
                if (!btn) return;
                var targetId = btn.getAttribute('data-tab-target');
                var btns = tabBar.querySelectorAll('.bb-tab-btn');
                for (var i = 0; i < btns.length; i++) {
                    var active = btns[i] === btn;
                    btns[i].classList.toggle('is-active', active);
                    btns[i].setAttribute('aria-selected', active ? 'true' : 'false');
                }
                var panels = tabBar.parentElement.querySelectorAll('.bb-tab-panel');
                for (var j = 0; j < panels.length; j++) {
                    panels[j].classList.toggle('is-active', panels[j].id === targetId);
                }
            });
        }

        var slider = document.getElementById('sidebarSlider');
        if (slider) {
            var slides = slider.querySelectorAll('.bb-slide');
            var dots = slider.querySelectorAll('.bb-slider-dot');
            var current = 0;
            var timer = null;

            var showSlide = function (index) {
                current = (index + slides.length) % slides.length;
                for (var i = 0; i < slides.length; i++) {
                    slides[i].classList.toggle('is-active', i === current);
                    if (dots[i]) dots[i].classList.toggle('is-active', i === current);
                }
            };
            var startAuto = function () {
                stopAuto();
                timer = setInterval(function () { showSlide(current + 1); }, 4200);
            };
            var stopAuto = function () {
                if (timer) { clearInterval(timer); timer = null; }
            };

            var prevBtn = document.getElementById('sidebarPrev');
            var nextBtn = document.getElementById('sidebarNext');
            if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); startAuto(); });
            if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); startAuto(); });
            for (var d = 0; d < dots.length; d++) {
                dots[d].addEventListener('click', function () {
                    showSlide(parseInt(this.getAttribute('data-slide'), 10) || 0);
                    startAuto();
                });
            }
            slider.addEventListener('mouseenter', stopAuto);
            slider.addEventListener('mouseleave', startAuto);
            startAuto();
        }
    });
</script>