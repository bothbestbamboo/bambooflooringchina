---
export interface Props {
  title?: string;
  keywords?: string;
  description?: string;
  bodyClass?: string;
  footerType?: 'home' | 'postscript' | 'simple';
  rssUrl?: string;
  extraCss?: string[];
  extraJs?: string[];
  headHtml?: string;
}

const {
  title = "Bamboo Flooring: China Factory Wholesale",
  keywords = "bamboo flooring, china, factory, wholesale",
  description = "Bothbest is a China factory manufacturing bamboo flooring and offers bamboo flooring price in wholesale, guaranteed quality, worldwide shipping.",
  bodyClass = "html front not-logged-in no-sidebars page-node",
  footerType = "postscript",
  rssUrl = "/rss/products.xml",
  extraCss = [],
  extraJs = [],
  headHtml = ""
} = Astro.props;

// 自动获取最新 3 篇新闻用于首页底部展示
const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });
const latestThreeNews = Object.values(newsFiles)
  .sort((a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0))
  .slice(0, 3);
---
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>{title}</title>
    <meta name="Keywords" content={keywords} />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <script is:inline type="text/javascript" src="/js/jquery.js"></script>
    <script is:inline type="text/javascript" src="/js/OncePlugin.js"></script>
    {extraJs.map((jsPath) => (
        <script is:inline type="text/javascript" src={jsPath}></script>
    ))}
    <script is:inline type="text/javascript" src="/js/parentWindow.js"></script>
    <!-- 先加载内页附加的相册插件样式与脚本 -->
    {headHtml && <Fragment set:html={headHtml} />}
    <!-- 后加载全站主样式表，确保主样式不被插件覆盖 -->
    <link type="text/css" rel="stylesheet" href="/css/peVolo.css" media="all" />
    {extraCss.map((cssPath) => (
        <link type="text/css" rel="stylesheet" href={cssPath} />
    ))}
    <link href="/css/skin_orange.css" rel="stylesheet" />
    <style is:inline>
        /* 锁定页脚与引言区原版字号、粗细与配色，防止被内页插件污染 */
        footer .footerLower { font-size: 12px; line-height: 20px; }
        footer .footerLower h3 { font-size: 16px; font-weight: bold; color: #333333; }
        footer .footerLower ul.f_contact li,
        footer .footerLower nav.f_menu ul li a,
        footer .footerLower p { font-size: 12px; }
        footer .postscript blockquote p a { color: #517329 !important; }
    </style>
    <!--[if lt IE 9]>
        <script src="/js/html5shim.js"></script>
    <![endif]-->
    <script is:inline type="text/javascript">
        window.onerror = function () { return true; }
    </script>
</head>
<body class={bodyClass}>
    <header class="navbar navbar-fixed-top" id="top">
        <div class="navbar-inner">
            <div class="container">
                <a class="btn btn-navbar" data-toggle="collapse" data-target=".nav-collapse">
                    <span class="btnTitle">Menu</span>
                    <span class="icon-chevron-down icon-white"></span>
                </a>
                <a class="brand" href="/" title="Home">
                    <img src="/img/skin/logo.png" alt="Home" />
                </a>
                <div class="nav-collapse">
                    <div class="header ">
                        <div id="block-block-9" class="block block-block smedia">
                            <div>
                                <a rel="external nofollow" href="mailto:info@bambooflooringchina.com" data-rel="tooltip" data-position="bottom" class="sm-icon sm-icon-Email" data-original-title="Email" target="_blank"></a>
                                <form action="/search.html" method="get">
                                    <select name="type" id="type">
                                        <option value="products">Products</option>
                                        <option value="news">News</option>
                                    </select>
                                    <input type="text" name="SearchKeywords" id="SearchKeywords" />
                                    <input type="submit" id="search" name="search" value="Search" class="form-submit" />
                                </form>
                            </div>
                        </div>
                    </div>
                    <ul class="nav">
                        <li class="leaf"><a href="/products/product-type-BambooFlooring.html">Flooring</a></li>
                        <li class="leaf"><a href="/products/product-type-BambooDecking.html">Decking</a></li>
                        <li class="leaf"><a href="/products/product-type-BambooPanels.html">Panels</a></li>  
                        <li class="leaf"><a href="/products/product-type-BambooCollection.html">More</a></li>
                        <li class="leaf"><a href="/clearance/clearance_1.html">Clearance</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>
    <!-- /#header -->

    <slot />

    <footer>
        {footerType === 'home' && (
            <section class="footerMain">
                <div class="container">
                    <div class="footer row-fluid">
                        <div class="block span4">
                            <h3>About Us</h3>
                            <p>Bothbest is a proud China-based company focusing on bamboo only because it is an amazing rapidly renewable resource, we manufacture largest variety and best quality of bamboo, such as bamboo flooring, bamboo decking, bamboo panels and more creative bamboo products.<br /><br />We are equipped with high-tech computerized machines and have been recognized as a professional supplier and exporter in bamboo market world widely.<br /><br />BothBest products hav...</p>
                        </div>
                        <div class="block span4">
                            <h3>News</h3>
                            <div class="view view-blog view-id-blog view-display-id-block recent-posts view-dom-id-8c278bd04ca1d050fd8f7387a7419a7f">
                                <div class="view-content">
                                    <ul>
                                        {latestThreeNews.map((n: any) => {
                                            const t = n.frontmatter.title || '';
                                            const s = n.frontmatter.summary || '';
                                            return (
                                                <li>
                                                    <a class="title" href={`/news/${n.frontmatter.slug}.html`}>{t.length > 40 ? t.slice(0, 40) + '...' : t}</a>
                                                    <p>{s.length > 74 ? s.slice(0, 74) + '...' : s}</p>
                                                </li>
                                            );
                                        })}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="block span4 last">
                            <h3>Newsletter</h3>
                            <p>To stay in touch with us for receiving the latest bamboo products, bamboo news and special promotion pricing, please sign up to our newsletter freely and securely.</p>
                            <form class="letter_form" id="newsletter-form" action="https://api.web3forms.com/submit" method="POST">
                                <input type="hidden" name="access_key" value="81ff5088-e596-4b27-851b-cbaf5ab4a4f9" />
                                <input type="hidden" name="subject" value="New Newsletter Subscription - Bothbest" />
                                <input type="hidden" name="from_name" value="Bothbest Website Newsletter" />
                                <input type="email" name="email" id="newsletter" class="l_form" value="" placeholder="Enter your email address..." required />
                                <input type="submit" id="ok" value="" />
                            </form>
                            <p id="newsletter-msg" style="display:none; color:#468847; font-weight:bold; margin-top:5px;"></p>
                            <p class="outro">
                                <img src="/img/skin/let_d.png" alt="" />
                                <span>Your email address will be totally secure and will only be used when we send you our newsletter. We promise that your email address will never be used for any other purpose and will never be shared.</span>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        )}

        {footerType === 'postscript' && (
            <section class="postscript ">
                <div class="container">
                    <div id="block-block-2" class="block block-block">
                        <div class="row-fluid">
                            <div class="span9">
                                <blockquote>
                                    <p>"Allow us to help you, to help your business! Call us on <span class="tel">+86 150 0582 0528</span> or get in touch via email at <a href="mailto:info@bambooflooringchina.com">info@bambooflooringchina.com</a>"</p>
                                </blockquote>
                            </div>
                            <div class="span3 mugshot">
                                <img src="/img/skin/client_mug2.png" alt="client" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        )}

        <section class="footerLower">
            <div class="container">
                <div class="row-fluid">
                    <div class="span3">
                        <h3>Contact Us</h3>
                        <ul class="f_contact">
                            <li><img src="/img/skin/li_phone.png" alt="" />+86 150 0582 0528</li>
                            <li><img src="/img/skin/li_skype.png" alt="" />bambooflooring</li>
                            <li><img src="/img/skin/li_adr.png" alt="" />Tangpu Industrial Zone, Anji</li>
                            <li><img src="/img/skin/li_let.png" alt="" />info@bambooflooringchina.com</li>
                        </ul>
                    </div>
                    <div class="span3">
                        <h3>Navigation</h3>
                        <nav class="f_menu">
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a href="/about.html">About</a></li>
                                <li><a href="/news/news_1.html">News</a></li>
                                <li><a href="/gallery.html">Gallery</a></li>
                                <li><a href="/products.html">Products</a></li>
                                <li><a href="/clearance/clearance_1.html">Clearance</a></li>
                            </ul>
                        </nav>
                    </div>
                    <div class="span3">
                        <h3>Products</h3>
                        <nav class="f_menu">
                            <ul>
                                <li><a href="/products/product-type-BambooCollection.html">Bamboo Collection</a></li>
                                <li><a href="/products/product-type-BambooDecking.html">Bamboo Decking</a></li>
                                <li><a href="/products/product-type-BambooPanels.html">Bamboo Panels</a></li>
                                <li><a href="/products/product-type-BambooFlooring.html">Bamboo Flooring</a></li>
                            </ul>
                        </nav>
                    </div>
                    <div class="span3">
                        <img src="/img/skin/logo_sml.png" alt="Bothbest" />
                        <p class="copyright">Copyright @2026 Bothbest</p>
                        <p class="sns">
                            <a rel="external nofollow" href={rssUrl} data-rel="tooltip" data-position="bottom" class="sm-icon sm-icon-rss" data-original-title="RSS" target="_blank"></a>
                        </p>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </section>
    </footer>
    <!-- /#footer -->
    <a href="#top" id="peBackToTop" class="label btt disabled"><span class="icon-chevron-up icon-white"></span></a>

    <script is:inline type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var searchForms = document.querySelectorAll('form[action*="search.aspx"]');
            for (var i = 0; i < searchForms.length; i++) {
                searchForms[i].setAttribute('action', '/search.html');
            }

            var newsletterForm = document.getElementById('newsletter-form');
            var newsletterMsg = document.getElementById('newsletter-msg');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formData = new FormData(newsletterForm);
                    fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        body: formData
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success) {
                            newsletterMsg.style.display = 'block';
                            newsletterMsg.style.color = '#468847';
                            newsletterMsg.textContent = 'Thank you for subscribing to our newsletter!';
                            newsletterForm.reset();
                        } else {
                            alert('Subscription failed: ' + (data.message || 'Please check your access_key.'));
                        }
                    })
                    .catch(function () {
                        alert('Network error, please try again later.');
                    });
                });
            }
        });
    </script>
</body>
</html>