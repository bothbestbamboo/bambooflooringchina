---
export interface Props {
  title?: string;
  keywords?: string;
  description?: string;
  bodyClass?: string;
  footerType?: 'home' | 'postscript' | 'simple';
  rssUrl?: string;
  extraCss?: string[];
  extraJs?: string[];
  headHtml?: string;
  loadLegacyJs?: boolean;
  preloadImage?: string;
  isModern?: boolean;
}

const {
  title = "Bamboo Flooring: China Factory Wholesale | Bothbest",
  keywords = "bamboo flooring, china, factory, wholesale",
  description = "Bothbest is a China factory manufacturing bamboo flooring and offers bamboo flooring price in wholesale, guaranteed quality, worldwide shipping.",
  bodyClass = "html front not-logged-in no-sidebars page-node",
  footerType = "postscript",
  extraCss = [],
  extraJs = [],
  headHtml = "",
  loadLegacyJs = true,
  preloadImage = "",
  isModern = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site || 'https://www.bambooflooringchina.com').href;

// 顶部导航仅保留 5 个核心产品栏目，其余栏目归入 Footer
const navItems = [
  { label: 'Flooring', href: '/products/product-type-BambooFlooring.html' },
  { label: 'Decking', href: '/products/product-type-BambooDecking.html' },
  { label: 'Panels', href: '/products/product-type-BambooPanels.html' },
  { label: 'More', href: '/products/product-type-BambooCollection.html' },
  { label: 'Clearance', href: '/clearance/clearance_1.html', matchPrefix: '/clearance/' },
];

const finalBodyClass = isModern ? 'bb-modern' : bodyClass;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="keywords" content={keywords} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="shortcut icon" type="image/x-icon" href="/img/UploadFiles/favicon.ico" />
    {preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    {!isModern && loadLegacyJs && (
        <>
            <script is:inline src="/js/jquery.js"></script>
            {extraJs.map((jsPath) => (
                <script is:inline src={jsPath}></script>
            ))}
            <script is:inline src="/js/parentWindow.js"></script>
        </>
    )}

    {headHtml && <Fragment set:html={headHtml} />}

    {!isModern && (
        <>
            <link rel="stylesheet" href="/css/peVolo.css" media="all" />
            {extraCss.map((cssPath) => (
                <link rel="stylesheet" href={cssPath} />
            ))}
            <link rel="stylesheet" href="/css/skin_orange.css" />
        </>
    )}
    <link rel="stylesheet" href="/css/modern.css" media="all" />
</head>
<body class={finalBodyClass} id="top">
    <header class="bb-header">
        <div class="bb-topbar">
            <div class="bb-container bb-topbar-inner">
                <div class="bb-topbar-note">
                    <span class="bb-topbar-dot" aria-hidden="true"></span>
                    <span>FSC &amp; CE Certified Bamboo Manufacturer Since 2001 &middot; Anji, China</span>
                </div>
                <div class="bb-topbar-contacts">
                    <a href="mailto:info@bambooflooringchina.com">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                        <span>info@bambooflooringchina.com</span>
                    </a>
                    <a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12.04 2A9.94 9.94 0 0 0 3.3 16.8L2 22l5.33-1.39A9.95 9.95 0 1 0 12.04 2zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.48.13.65-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.07.13.07.73-.17 1.41z"/>
                        </svg>
                        <span>+86 150 0582 0528</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="bb-navwrap">
            <div class="bb-container bb-navbar">
                <a class="bb-brand" href="/" title="Bothbest Bamboo Flooring">
                    <img
                        src="/img/skin/newlogo2.png"
                        width="630"
                        height="180"
                        alt="Bothbest Bamboo Flooring Factory Since 2001"
                        decoding="async"
                    />
                </a>

                <nav class="bb-nav-center" aria-label="Product navigation">
                    <ul class="bb-nav">
                        {navItems.map((item) => {
                            const isActive =
                                currentPath === item.href ||
                                (item.matchPrefix && currentPath.startsWith(item.matchPrefix));
                            return (
                                <li>
                                    <a href={item.href} class={isActive ? 'is-active' : undefined}>{item.label}</a>
                                </li>
                            );
                        })}
                    </ul>
                </nav>

                <div class="bb-nav-actions">
                    <button
                        type="button"
                        class="bb-icon-btn"
                        id="bbSearchToggle"
                        aria-label="Open search"
                        aria-expanded="false"
                        aria-controls="bbSearchDrawer"
                    >
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.3-4.3"></path>
                        </svg>
                    </button>
                    <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary bb-btn-sm">Get a Quote</a>
                    <button
                        type="button"
                        class="bb-icon-btn bb-menu-toggle"
                        id="bbMenuToggle"
                        aria-label="Toggle menu"
                        aria-expanded="false"
                        aria-controls="bbMobileDrawer"
                    >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="bb-search-drawer" id="bbSearchDrawer">
            <div class="bb-container">
                <form action="/search.html" method="get" class="bb-search-form" role="search">
                    <select name="type" aria-label="Search category">
                        <option value="products">Products</option>
                        <option value="news">News</option>
                    </select>
                    <input
                        type="text"
                        name="SearchKeywords"
                        id="bbSearchInput"
                        placeholder="Search bamboo flooring, decking, panels..."
                        aria-label="Search keywords"
                    />
                    <button type="submit" class="bb-btn bb-btn-green">Search</button>
                </form>
            </div>
        </div>

        <div class="bb-mobile-drawer" id="bbMobileDrawer">
            <form action="/search.html" method="get" class="bb-mobile-search" role="search">
                <input type="hidden" name="type" value="products" />
                <input type="text" name="SearchKeywords" placeholder="Search bamboo..." aria-label="Search keywords" />
                <button type="submit" class="bb-btn bb-btn-green bb-btn-sm">Search</button>
            </form>
            <ul class="bb-mobile-nav">
                {navItems.map((item) => {
                    const isActive =
                        currentPath === item.href ||
                        (item.matchPrefix && currentPath.startsWith(item.matchPrefix));
                    return (
                        <li>
                            <a href={item.href} class={isActive ? 'is-active' : undefined}>{item.label}</a>
                        </li>
                    );
                })}
            </ul>
            <div class="bb-mobile-subnav">
                <a href="/about.html">About Factory</a>
                <a href="/gallery.html">Gallery</a>
                <a href="/news/news_1.html">News</a>
            </div>
            <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary" style="width: 100%;">Request Wholesale Quote</a>
        </div>
    </header>

    <slot />

    {footerType === 'home' && (
        <section class="bb-cta-band">
            <div class="bb-container bb-cta-grid">
                <div>
                    <h2>Ready to Source Direct From Our Bamboo Factory?</h2>
                    <p>Request free product samples, technical datasheets, or container wholesale pricing. Our export team responds within 24 hours.</p>
                    <div class="bb-cta-actions">
                        <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary">Request a Quote</a>
                        <a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer" class="bb-btn bb-btn-outline-light">WhatsApp Direct</a>
                    </div>
                </div>
                <div class="bb-newsletter-box">
                    <h3>Factory Newsletter</h3>
                    <p>Receive new bamboo product launches, technical guides, and wholesale clearance updates.</p>
                    <form class="bb-newsletter-form" id="newsletter-form" action="https://api.web3forms.com/submit" method="POST">
                        <input type="hidden" name="access_key" value="81ff5088-e596-4b27-851b-cbaf5ab4a4f9" />
                        <input type="hidden" name="subject" value="New Newsletter Subscription - Bothbest" />
                        <input type="hidden" name="from_name" value="Bothbest Website Newsletter" />
                        <input type="email" name="email" id="newsletter" placeholder="Enter your business email..." aria-label="Email address" required />
                        <button type="submit" class="bb-btn bb-btn-primary">Subscribe</button>
                    </form>
                    <p id="newsletter-msg" class="bb-newsletter-msg"></p>
                    <p class="bb-newsletter-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M18 8h-1V6a5 5 0 0 0-10 0v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zm-8-2a2 2 0 1 1 4 0v2h-4V6z"/>
                        </svg>
                        <span>Strictly confidential. Never shared with third parties.</span>
                    </p>
                </div>
            </div>
        </section>
    )}

    {footerType === 'postscript' && (
        <section class="bb-cta-band">
            <div class="bb-container bb-cta-grid is-single">
                <div>
                    <h2>Need Wholesale Pricing or Custom Bamboo Specifications?</h2>
                    <p>Talk directly with our factory team in Anji on +86 150 0582 0528 or email info@bambooflooringchina.com.</p>
                </div>
                <div class="bb-cta-actions">
                    <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary">Request a Quote</a>
                    <a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer" class="bb-btn bb-btn-outline-light">WhatsApp Us</a>
                </div>
            </div>
        </section>
    )}

    <footer class="bb-footer">
        <div class="bb-container bb-footer-main">
            <div class="bb-footer-grid">
                <div>
                    <img src="/img/skin/logo_sml.png" alt="Bothbest Bamboo" class="bb-footer-logo" loading="lazy" decoding="async" />
                    <p class="bb-footer-about">
                        China-based FSC &amp; CE certified bamboo manufacturer since 2001. Supplying wholesale bamboo flooring, outdoor decking, plywood, and veneer worldwide.
                    </p>
                </div>
                <div>
                    <h3>Products</h3>
                    <ul class="bb-footer-links">
                        <li><a href="/products/product-type-BambooFlooring.html">Bamboo Flooring</a></li>
                        <li><a href="/products/product-type-BambooDecking.html">Bamboo Decking</a></li>
                        <li><a href="/products/product-type-BambooPanels.html">Bamboo Panels</a></li>
                        <li><a href="/products/product-type-BambooCollection.html">Bamboo Collection</a></li>
                        <li><a href="/clearance/clearance_1.html">Clearance Stock</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Company</h3>
                    <ul class="bb-footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/about.html">About Factory</a></li>
                        <li><a href="/products.html">All Products</a></li>
                        <li><a href="/gallery.html">Project Gallery</a></li>
                        <li><a href="/news/news_1.html">Technical News</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Contact Factory</h3>
                    <ul class="bb-footer-contact">
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
                            <a href="tel:+8615005820528">+86 150 0582 0528</a>
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2A9.94 9.94 0 0 0 3.3 16.8L2 22l5.33-1.39A9.95 9.95 0 1 0 12.04 2zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.48.13.65-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.07.13.07.73-.17 1.41z"/></svg>
                            <a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer">WhatsApp: +86 150 0582 0528</a>
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
                            <a href="mailto:info@bambooflooringchina.com">info@bambooflooringchina.com</a>
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                            <span>Tangpu Industrial Zone, Anji, Zhejiang, China</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="bb-footer-bottom">
            <div class="bb-container bb-footer-bottom-inner">
                <p>Copyright &copy; 2026 Bothbest Bamboo. All Rights Reserved.</p>
                <p>Factory-Direct Wholesale Exporter &middot; Anji, China</p>
            </div>
        </div>
    </footer>

    <a href="#top" id="bbBackToTop" class="bb-btt is-hidden" aria-label="Back to top">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="m18 15-6-6-6 6"></path>
        </svg>
    </a>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var searchBtn = document.getElementById('bbSearchToggle');
            var searchDrawer = document.getElementById('bbSearchDrawer');
            var searchInput = document.getElementById('bbSearchInput');
            var menuBtn = document.getElementById('bbMenuToggle');
            var mobileDrawer = document.getElementById('bbMobileDrawer');

            if (searchBtn && searchDrawer) {
                searchBtn.addEventListener('click', function () {
                    var opened = searchDrawer.classList.toggle('is-open');
                    searchBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
                    if (opened && mobileDrawer) {
                        mobileDrawer.classList.remove('is-open');
                        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
                    }
                    if (opened && searchInput) searchInput.focus();
                });
            }

            if (menuBtn && mobileDrawer) {
                menuBtn.addEventListener('click', function () {
                    var opened = mobileDrawer.classList.toggle('is-open');
                    menuBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
                    if (opened && searchDrawer) {
                        searchDrawer.classList.remove('is-open');
                        if (searchBtn) searchBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            var btt = document.getElementById('bbBackToTop');
            if (btt) {
                var toggleBtt = function () {
                    btt.classList.toggle('is-hidden', window.scrollY <= 240);
                };
                window.addEventListener('scroll', toggleBtt, { passive: true });
                toggleBtt();
                btt.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            var newsletterForm = document.getElementById('newsletter-form');
            var newsletterMsg = document.getElementById('newsletter-msg');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var submitBtn = newsletterForm.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;
                    fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        body: new FormData(newsletterForm)
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success) {
                            newsletterMsg.style.display = 'block';
                            newsletterMsg.textContent = 'Thank you for subscribing to our newsletter!';
                            newsletterForm.reset();
                        } else {
                            alert('Subscription failed: ' + (data.message || 'Please try again.'));
                        }
                    })
                    .catch(function () {
                        alert('Network error, please try again later.');
                    })
                    .finally(function () {
                        if (submitBtn) submitBtn.disabled = false;
                    });
                });
            }
        });
    </script>
</body>
</html>