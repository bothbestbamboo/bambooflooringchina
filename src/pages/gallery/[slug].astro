---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const galleryFiles = import.meta.glob('../../data/gallery/*.md', { eager: true });
  return Object.values(galleryFiles).map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { frontmatter, Content } = post;

const rawMainHtml: string = frontmatter.mainHtml || (post.compiledContent ? await post.compiledContent() : '');
const rawHeadHtml: string = frontmatter.headHtml || '';
const rawFootHtml: string = frontmatter.footHtml || '';

const getAttr = (tag: string, name: string) => {
  const m = tag.match(new RegExp(`\\b${name}=["']([^"']*)["']`, 'i'));
  return m ? m[1] : '';
};

const stripTags = (str: string) => str.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

let cleanTitle = '';
let galleryDesc = '';

const h1Match = rawMainHtml.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
if (h1Match) {
  const inner = h1Match[1].trim();
  const splitTag = inner.match(/^([\s\S]*?)<(?:span|small|p|div|br)\b[^>]*>([\s\S]*)$/i);
  if (splitTag && stripTags(splitTag[1]).length >= 4) {
    cleanTitle = stripTags(splitTag[1]);
    galleryDesc = stripTags(splitTag[2]);
  } else {
    cleanTitle = stripTags(inner);
  }
}

const metaTitle = String(frontmatter.title || '').split('|')[0].trim();
if (!cleanTitle) {
  cleanTitle = metaTitle || 'Project Gallery';
}

if (cleanTitle.length > 65 && !galleryDesc) {
  if (metaTitle && metaTitle.length >= 6 && metaTitle.length <= 65 && metaTitle.toLowerCase() !== 'gallery') {
    galleryDesc = cleanTitle;
    cleanTitle = metaTitle;
  } else {
    const transition = cleanTitle.match(/^(.{12,}?)\s+([A-Z][a-z]+\s+[a-z]{2,}\s+[a-z]{2,}[\s\S]*)$/);
    if (transition) {
      cleanTitle = transition[1].trim();
      galleryDesc = transition[2].trim();
    } else {
      const sentence = cleanTitle.match(/^([^.!?]{12,75})[.!?]\s+([\s\S]+)$/);
      if (sentence) {
        cleanTitle = sentence[1].trim();
        galleryDesc = sentence[2].trim();
      }
    }
  }
}

const breadcrumbLabel = cleanTitle.length > 52 ? cleanTitle.slice(0, 52).trim() + '...' : cleanTitle;

const isElastislide = /rg-gallery|es-carousel|data-large/i.test(rawMainHtml);
const extractedImages: { large: string; thumb: string; alt: string; caption: string }[] = [];

if (isElastislide) {
  const seen = new Set<string>();
  const imgTags = rawMainHtml.match(/<img\b[^>]*>/gi) || [];
  for (const tag of imgTags) {
    const dataLarge = getAttr(tag, 'data-large');
    const src = getAttr(tag, 'src');
    const large = dataLarge || src;
    if (!large || large.includes('/img/skin/') || large.includes('blank.png')) continue;
    if (seen.has(large)) continue;
    seen.add(large);
    extractedImages.push({
      large,
      thumb: src || large,
      alt: getAttr(tag, 'alt') || cleanTitle,
      caption: getAttr(tag, 'data-description') || getAttr(tag, 'title') || '',
    });
  }
}

const useNativeGallery = extractedImages.length > 0;

let fallbackHtml = '';
let needsLegacyJs = false;
if (!useNativeGallery && frontmatter.mainHtml) {
  let imgIdx = 0;
  fallbackHtml = rawMainHtml
    .replace(/action=['"]\/search\.aspx['"]/gi, 'action="/search.html"')
    .replace(/name=['"]MobileSearchKeywords['"]/gi, 'name="SearchKeywords"')
    .replace(/href=['"]\/index\.html['"]/gi, 'href="/"')
    .replace(/<img\b([^>]*)>/gi, (match, attrs) => {
      imgIdx++;
      let next = attrs;
      if (!/\bdecoding=/i.test(next)) next += ' decoding="async"';
      if (imgIdx > 2 && !/\bloading=/i.test(next)) next += ' loading="lazy"';
      return `<img${next}>`;
    });
  needsLegacyJs = /<script/i.test(rawHeadHtml + rawFootHtml) || /peVolo/i.test(rawMainHtml);
}

const firstImage = useNativeGallery ? extractedImages[0].large : '';
---
<BaseLayout
  title={frontmatter.title || `${cleanTitle} | Bothbest Gallery`}
  keywords={frontmatter.keywords || "bamboo flooring gallery, bamboo decking project, Bothbest"}
  description={frontmatter.description || galleryDesc || `Project photos of ${cleanTitle} by Bothbest China bamboo factory.`}
  bodyClass="html not-front not-logged-in no-sidebars"
  footerType={frontmatter.footerType || "postscript"}
  headHtml={useNativeGallery ? "" : rawHeadHtml}
  loadLegacyJs={useNativeGallery ? false : needsLegacyJs}
  isModern={useNativeGallery}
  preloadImage={firstImage}
>
  {useNativeGallery ? (
    <>
      <div class="bb-pd-crumb-bar">
        <div class="bb-container">
          <ol class="bb-breadcrumb">
            <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
            <li><a href="/gallery.html">Gallery</a><span class="bb-breadcrumb-sep">/</span></li>
            <li aria-current="page">{breadcrumbLabel}</li>
          </ol>
        </div>
      </div>

      <section class="bb-main-section">
        <div class="bb-container">
          <div class="bb-gd-header">
            <h1 class="bb-page-title">{cleanTitle}</h1>
            <a href="/gallery.html" class="bb-link-arrow">&larr; Back to Gallery</a>
          </div>
          {galleryDesc && <p class="bb-gd-desc">{galleryDesc}</p>}

          <div class="bb-viewer" id="nativeGallery" data-total={extractedImages.length}>
            <div class="bb-viewer-stage">
              <img
                id="ngMainImg"
                src={extractedImages[0].large}
                alt={extractedImages[0].alt}
                fetchpriority="high"
                decoding="async"
              />
              {extractedImages.length > 1 && (
                <>
                  <button type="button" class="bb-slider-btn bb-slider-prev" id="ngPrev" aria-label="Previous photo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <button type="button" class="bb-slider-btn bb-slider-next" id="ngNext" aria-label="Next photo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </>
              )}
              <div class="bb-viewer-counter" id="ngCounter">1 / {extractedImages.length}</div>
            </div>

            <div class="bb-viewer-caption" id="ngCaption" style={extractedImages[0].caption ? '' : 'display:none;'}>
              {extractedImages[0].caption}
            </div>

            {extractedImages.length > 1 && (
              <div class="bb-viewer-thumbs" id="ngThumbs" role="listbox" aria-label="Gallery thumbnails">
                {extractedImages.map((img, idx) => (
                  <button
                    type="button"
                    class={`bb-viewer-thumb${idx === 0 ? ' is-active' : ''}`}
                    data-idx={idx}
                    data-large={img.large}
                    data-alt={img.alt}
                    data-caption={img.caption}
                    aria-label={`View photo ${idx + 1}`}
                    aria-selected={idx === 0 ? 'true' : 'false'}
                  >
                    <img
                      src={img.thumb}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                      width="100"
                      height="80"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="bb-gd-cta">
            <div>
              <strong>Interested in this bamboo project style?</strong>
              <span>Request matching samples, custom finishes, or container wholesale pricing from our factory.</span>
            </div>
            <a href={`/about.html?product=${encodeURIComponent(`Gallery: ${cleanTitle}`)}#RequestAQuote`} class="bb-btn bb-btn-primary">
              Request A Quote
            </a>
          </div>
        </div>

        <div class="bb-lightbox" id="ngLightbox" hidden aria-modal="true" role="dialog" aria-label="Image preview">
          <button type="button" class="bb-lightbox-close" id="ngLbClose" aria-label="Close preview">&times;</button>
          <img id="ngLbImg" src="" alt="" />
        </div>
      </section>
    </>
  ) : frontmatter.mainHtml ? (
    <div class="bb-legacy-cat">
      <Fragment set:html={fallbackHtml} />
      {rawFootHtml && <Fragment set:html={rawFootHtml} />}
    </div>
  ) : (
    <Content />
  )}

  {useNativeGallery && (
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var mainImg = document.getElementById('ngMainImg');
            var captionEl = document.getElementById('ngCaption');
            var counterEl = document.getElementById('ngCounter');
            var thumbs = document.querySelectorAll('#ngThumbs .bb-viewer-thumb');
            var prevBtn = document.getElementById('ngPrev');
            var nextBtn = document.getElementById('ngNext');
            var lightbox = document.getElementById('ngLightbox');
            var lbImg = document.getElementById('ngLbImg');
            var lbClose = document.getElementById('ngLbClose');
            if (!mainImg) return;

            var current = 0;
            var total = thumbs.length || 1;

            var selectPhoto = function (index) {
                if (thumbs.length === 0) return;
                current = (index + total) % total;
                var btn = thumbs[current];
                var large = btn.getAttribute('data-large');
                var alt = btn.getAttribute('data-alt') || '';
                var caption = btn.getAttribute('data-caption') || '';

                mainImg.src = large;
                mainImg.alt = alt;
                if (counterEl) counterEl.textContent = (current + 1) + ' / ' + total;
                if (captionEl) {
                    captionEl.textContent = caption;
                    captionEl.style.display = caption ? 'block' : 'none';
                }

                for (var i = 0; i < thumbs.length; i++) {
                    var active = i === current;
                    thumbs[i].classList.toggle('is-active', active);
                    thumbs[i].setAttribute('aria-selected', active ? 'true' : 'false');
                }
                btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            };

            if (prevBtn) prevBtn.addEventListener('click', function () { selectPhoto(current - 1); });
            if (nextBtn) nextBtn.addEventListener('click', function () { selectPhoto(current + 1); });

            for (var i = 0; i < thumbs.length; i++) {
                thumbs[i].addEventListener('click', function () {
                    selectPhoto(parseInt(this.getAttribute('data-idx'), 10) || 0);
                });
            }

            if (lightbox && lbImg) {
                mainImg.addEventListener('click', function () {
                    lbImg.src = mainImg.src;
                    lbImg.alt = mainImg.alt;
                    lightbox.hidden = false;
                });
                var closeLb = function () { lightbox.hidden = true; };
                if (lbClose) lbClose.addEventListener('click', closeLb);
                lightbox.addEventListener('click', function (e) {
                    if (e.target === lightbox) closeLb();
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && !lightbox.hidden) closeLb();
                    if (thumbs.length > 1 && lightbox.hidden) {
                        if (e.key === 'ArrowLeft') selectPhoto(current - 1);
                        if (e.key === 'ArrowRight') selectPhoto(current + 1);
                    }
                });
            }
        });
    </script>
  )}
</BaseLayout>