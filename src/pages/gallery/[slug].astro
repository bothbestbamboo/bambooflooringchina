---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const galleryFiles = import.meta.glob('../../data/gallery/*.md', { eager: true });
  return Object.values(galleryFiles).map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { frontmatter, Content } = post;

const rawMainHtml: string = frontmatter.mainHtml || (post.compiledContent ? await post.compiledContent() : '');
const rawHeadHtml: string = frontmatter.headHtml || '';
const rawFootHtml: string = frontmatter.footHtml || '';

const getAttr = (tag: string, name: string) => {
  const m = tag.match(new RegExp(`\\b${name}=["']([^"']*)["']`, 'i'));
  return m ? m[1] : '';
};

const stripTags = (str: string) => str.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

let cleanTitle = '';
let galleryDesc = '';

const h1Match = rawMainHtml.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
if (h1Match) {
  const inner = h1Match[1].trim();
  const splitTag = inner.match(/^([\s\S]*?)<(?:span|small|p|div|br)\b[^>]*>([\s\S]*)$/i);
  if (splitTag && stripTags(splitTag[1]).length >= 4) {
    cleanTitle = stripTags(splitTag[1]);
    galleryDesc = stripTags(splitTag[2]);
  } else {
    cleanTitle = stripTags(inner);
  }
}

const metaTitle = String(frontmatter.title || '').split('|')[0].trim();
if (!cleanTitle) {
  cleanTitle = metaTitle || 'Project Gallery';
}

if (cleanTitle.length > 65 && !galleryDesc) {
  if (metaTitle && metaTitle.length >= 6 && metaTitle.length <= 65 && metaTitle.toLowerCase() !== 'gallery') {
    galleryDesc = cleanTitle;
    cleanTitle = metaTitle;
  } else {
    const transition = cleanTitle.match(/^(.{12,}?)\s+([A-Z][a-z]+\s+[a-z]{2,}\s+[a-z]{2,}[\s\S]*)$/);
    if (transition) {
      cleanTitle = transition[1].trim();
      galleryDesc = transition[2].trim();
    } else {
      const sentence = cleanTitle.match(/^([^.!?]{12,75})[.!?]\s+([\s\S]+)$/);
      if (sentence) {
        cleanTitle = sentence[1].trim();
        galleryDesc = sentence[2].trim();
      }
    }
  }
}

const breadcrumbLabel = cleanTitle.length > 52 ? cleanTitle.slice(0, 52).trim() + '...' : cleanTitle;

const isElastislide = /rg-gallery|es-carousel|data-large/i.test(rawMainHtml);
const extractedImages: { large: string; alt: string; caption: string }[] = [];

if (isElastislide) {
  const seen = new Set<string>();
  const imgTags = rawMainHtml.match(/<img\b[^>]*>/gi) || [];
  for (const tag of imgTags) {
    const dataLarge = getAttr(tag, 'data-large');
    const src = getAttr(tag, 'src');
    const large = dataLarge || src;
    if (!large || large.includes('/img/skin/') || large.includes('blank.png')) continue;
    if (seen.has(large)) continue;
    seen.add(large);
    extractedImages.push({
      large,
      alt: getAttr(tag, 'alt') || cleanTitle,
      caption: getAttr(tag, 'data-description') || getAttr(tag, 'title') || '',
    });
  }
}

const useNativeGallery = extractedImages.length > 0;
const photoCount = extractedImages.length;

const gridLayoutClass =
  photoCount === 1
    ? 'bb-lookbook-grid is-single'
    : photoCount === 2
      ? 'bb-lookbook-grid is-pair'
      : 'bb-lookbook-grid has-mosaic';

let fallbackHtml = '';
let needsLegacyJs = false;
if (!useNativeGallery && frontmatter.mainHtml) {
  let imgIdx = 0;
  fallbackHtml = rawMainHtml
    .replace(/action=['"]\/search\.aspx['"]/gi, 'action="/search.html"')
    .replace(/name=['"]MobileSearchKeywords['"]/gi, 'name="SearchKeywords"')
    .replace(/href=['"]\/index\.html['"]/gi, 'href="/"')
    .replace(/<img\b([^>]*)>/gi, (match, attrs) => {
      imgIdx++;
      let next = attrs;
      if (!/\bdecoding=/i.test(next)) next += ' decoding="async"';
      if (imgIdx > 2 && !/\bloading=/i.test(next)) next += ' loading="lazy"';
      return `<img${next}>`;
    });
  needsLegacyJs = /<script/i.test(rawHeadHtml + rawFootHtml) || /peVolo/i.test(rawMainHtml);
}

const firstImage = useNativeGallery ? extractedImages[0].large : '';
const galleryDetailBanner = '/img/hero/gallery-banner.jpg';
const quoteUrl = `/about.html?product=${encodeURIComponent(`Gallery: ${cleanTitle}`)}#RequestAQuote`;
const waUrl = `https://wa.me/8615005820528?text=${encodeURIComponent(`Hi Bothbest, I saw your project gallery "${cleanTitle}" and would like matching bamboo specifications and wholesale pricing.`)}`;
---
<BaseLayout
  title={frontmatter.title || `${cleanTitle} | Bothbest Gallery`}
  keywords={frontmatter.keywords || "bamboo flooring gallery, bamboo decking project, Bothbest"}
  description={frontmatter.description || galleryDesc || `Project photos of ${cleanTitle} by Bothbest China bamboo factory.`}
  bodyClass="html not-front not-logged-in no-sidebars"
  footerType={frontmatter.footerType || "postscript"}
  headHtml={useNativeGallery ? "" : rawHeadHtml}
  loadLegacyJs={useNativeGallery ? false : needsLegacyJs}
  isModern={useNativeGallery}
  preloadImage={useNativeGallery ? galleryDetailBanner : firstImage}
>
  {useNativeGallery ? (
    <>
      <section class="bb-page-hero bb-page-hero--banner bb-gd-hero">
        <img
          src={galleryDetailBanner}
          alt={`${cleanTitle} — Bothbest Bamboo Project Gallery`}
          class="bb-page-hero-bg"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          onerror="this.style.display='none'"
        />
        <div class="bb-page-hero-overlay" aria-hidden="true"></div>
        <div class="bb-container">
          <ol class="bb-breadcrumb">
            <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
            <li><a href="/gallery.html">Gallery</a><span class="bb-breadcrumb-sep">/</span></li>
            <li aria-current="page">{breadcrumbLabel}</li>
          </ol>

          <div class="bb-gd-hero-row">
            <div class="bb-gd-hero-main">
              <h1 class="bb-page-title">{cleanTitle}</h1>
              {galleryDesc && <p class="bb-page-lead">{galleryDesc}</p>}
              <div class="bb-gd-meta-row">
                <span class="bb-gd-count-pill">{photoCount} Project {photoCount === 1 ? 'Photo' : 'Photos'}</span>
                <span class="bb-gd-hint">Click any photo to view full resolution</span>
              </div>
            </div>

            <div class="bb-gd-hero-actions">
              <a href="/gallery.html" class="bb-btn bb-btn-outline-light bb-btn-sm">&larr; All Projects</a>
              <a href={quoteUrl} class="bb-btn bb-btn-primary bb-btn-sm">Request Similar Quote</a>
            </div>
          </div>
        </div>
      </section>

      <section class="bb-lookbook-section">
        <div class="bb-container">
          <div class={gridLayoutClass} id="lookbookGrid">
            {extractedImages.map((img, idx) => (
              <button
                type="button"
                class="bb-lookbook-tile"
                data-lb-idx={idx}
                data-lb-src={img.large}
                data-lb-alt={img.alt}
                data-lb-caption={img.caption || `${cleanTitle} — Photo ${idx + 1} of ${photoCount}`}
                aria-label={`View photo ${idx + 1} of ${photoCount}`}
              >
                <img
                  src={img.large}
                  alt={img.alt}
                  fetchpriority={idx === 0 ? 'high' : undefined}
                  loading={idx < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="bb-lookbook-overlay" aria-hidden="true">
                  <span class="bb-lookbook-top">
                    <span class="bb-lookbook-num">{String(idx + 1).padStart(2, '0')} / {String(photoCount).padStart(2, '0')}</span>
                    <span class="bb-lookbook-expand">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
                      </svg>
                    </span>
                  </span>
                  {img.caption && <span class="bb-lookbook-cap">{img.caption}</span>}
                </span>
              </button>
            ))}
          </div>

          <div class="bb-gd-inquiry-band">
            <div>
              <h2>Specify This Bamboo Look for Your Next Project</h2>
              <p>Request matching samples, custom plank dimensions, or container wholesale pricing direct from our Anji factory.</p>
            </div>
            <div class="bb-gd-inquiry-btns">
              <a href={quoteUrl} class="bb-btn bb-btn-primary">Request A Quote</a>
              <a href={waUrl} target="_blank" rel="nofollow noopener noreferrer" class="bb-btn bb-btn-outline-light">WhatsApp Direct</a>
            </div>
          </div>
        </div>

        <div class="bb-lightbox" id="gdLightbox" hidden aria-modal="true" role="dialog" aria-label="Full screen photo viewer">
          <button type="button" class="bb-lightbox-close" id="gdLbClose" aria-label="Close preview">&times;</button>
          {photoCount > 1 && (
            <>
              <button type="button" class="bb-lightbox-nav bb-lightbox-prev" id="gdLbPrev" aria-label="Previous photo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button type="button" class="bb-lightbox-nav bb-lightbox-next" id="gdLbNext" aria-label="Next photo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </>
          )}
          <div class="bb-lightbox-inner">
            <img id="gdLbImg" src="" alt="" />
            <div class="bb-lightbox-caption" id="gdLbCaption"></div>
          </div>
        </div>
      </section>
    </>
  ) : frontmatter.mainHtml ? (
    <div class="bb-legacy-cat">
      <Fragment set:html={fallbackHtml} />
      {rawFootHtml && <Fragment set:html={rawFootHtml} />}
    </div>
  ) : (
    <Content />
  )}

  {useNativeGallery && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var tiles = document.querySelectorAll('#lookbookGrid .bb-lookbook-tile');
        var lightbox = document.getElementById('gdLightbox');
        var lbImg = document.getElementById('gdLbImg');
        var lbCaption = document.getElementById('gdLbCaption');
        var lbClose = document.getElementById('gdLbClose');
        var lbPrev = document.getElementById('gdLbPrev');
        var lbNext = document.getElementById('gdLbNext');
        if (!tiles.length || !lightbox || !lbImg) return;

        var current = 0;

        var openPhoto = function (idx) {
          current = (idx + tiles.length) % tiles.length;
          var btn = tiles[current];
          lbImg.src = btn.getAttribute('data-lb-src') || '';
          lbImg.alt = btn.getAttribute('data-lb-alt') || '';
          if (lbCaption) {
            lbCaption.textContent = btn.getAttribute('data-lb-caption') || '';
          }
          lightbox.hidden = false;
        };

        var closeLb = function () {
          lightbox.hidden = true;
        };

        for (var i = 0; i < tiles.length; i++) {
          tiles[i].addEventListener('click', function () {
            openPhoto(parseInt(this.getAttribute('data-lb-idx'), 10) || 0);
          });
        }

        if (lbClose) lbClose.addEventListener('click', closeLb);
        if (lbPrev) lbPrev.addEventListener('click', function () { openPhoto(current - 1); });
        if (lbNext) lbNext.addEventListener('click', function () { openPhoto(current + 1); });

        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) closeLb();
        });

        document.addEventListener('keydown', function (e) {
          if (lightbox.hidden) return;
          if (e.key === 'Escape') closeLb();
          if (tiles.length > 1) {
            if (e.key === 'ArrowLeft') openPhoto(current - 1);
            if (e.key === 'ArrowRight') openPhoto(current + 1);
          }
        });
      });
    </script>
  )}
</BaseLayout>