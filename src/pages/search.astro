---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsSidebar from '../components/NewsSidebar.astro';

const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });

const searchIndex = [
  ...Object.values(productFiles).map((p: any) => ({
    type: 'products',
    title: String(p.frontmatter.pageTitle || p.frontmatter.title || '').replace(/Carbonzied/gi, 'Carbonized'),
    url: `/products/${p.frontmatter.slug}.html`,
    summary: String(p.frontmatter.summary || p.frontmatter.description || '').replace(/Carbonzied/gi, 'Carbonized'),
    date: p.frontmatter.date || '',
    image: p.frontmatter.thumb || p.frontmatter.images?.[0]?.src || '/img/skin/logo_sml.png',
    keywords: `${p.frontmatter.keywords || ''} ${(p.frontmatter.attributes || []).join(' ')}`
  })),
  ...Object.values(newsFiles).map((n: any) => ({
    type: 'news',
    title: n.frontmatter.title || '',
    url: `/news/${n.frontmatter.slug}.html`,
    summary: n.frontmatter.summary || n.frontmatter.description || '',
    date: n.frontmatter.date || '',
    image: '',
    keywords: n.frontmatter.keywords || ''
  }))
];
---
<BaseLayout
  title="Search Results | Bothbest Bamboo Flooring Factory"
  keywords="bamboo flooring, search, products, news"
  description="Search Bothbest bamboo flooring, bamboo decking, bamboo panels products and technical guides."
  footerType="postscript"
  loadLegacyJs={false}
  isModern={true}
>
    <section class="bb-page-hero">
        <div class="bb-container">
            <ol class="bb-breadcrumb">
                <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
                <li aria-current="page">Search</li>
            </ol>
            <h1 class="bb-page-title">Search Catalog &amp; Guides</h1>
            <p class="bb-page-lead">Find specific bamboo flooring specifications, decking profiles, panel thicknesses, or technical articles.</p>
        </div>
    </section>

    <section class="bb-main-section">
        <div class="bb-container bb-two-col">
            <div>
                <div class="bb-search-panel">
                    <form action="/search.html" method="get" class="bb-search-form" style="max-width: 100%;" role="search">
                        <select name="type" id="page-search-type" aria-label="Search category">
                            <option value="all">All</option>
                            <option value="products">Products</option>
                            <option value="news">News</option>
                        </select>
                        <input type="text" name="SearchKeywords" id="page-search-input" placeholder="Enter keywords (e.g. strand woven, decking, 30mm)..." aria-label="Search keywords" />
                        <button type="submit" class="bb-btn bb-btn-green">Search</button>
                    </form>
                </div>

                <p id="search-status" class="bb-search-status"></p>
                <div id="search-results-container" class="bb-search-list"></div>
            </div>

            <NewsSidebar />
        </div>
    </section>

    <script is:inline define:vars={{ searchIndex }}>
        (function () {
            var escapeHtml = function (str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            };

            var params = new URLSearchParams(window.location.search);
            var rawQuery = (params.get('SearchKeywords') || params.get('MobileSearchKeywords') || '').trim();
            var searchType = (params.get('type') || 'all').toLowerCase();

            var pageInput = document.getElementById('page-search-input');
            var topInput = document.getElementById('bbSearchInput');
            var pageTypeSelect = document.getElementById('page-search-type');

            if (pageInput) pageInput.value = rawQuery;
            if (topInput) topInput.value = rawQuery;
            if (pageTypeSelect && (searchType === 'products' || searchType === 'news' || searchType === 'all')) {
                pageTypeSelect.value = searchType;
            }

            var statusEl = document.getElementById('search-status');
            var containerEl = document.getElementById('search-results-container');

            if (!rawQuery) {
                statusEl.textContent = 'Enter a keyword above to search our bamboo products and technical guides.';
                return;
            }

            var keywords = rawQuery.toLowerCase().split(/\s+/).filter(Boolean);

            var results = searchIndex.filter(function (item) {
                if (searchType !== 'all' && item.type !== searchType) return false;
                var haystack = (item.title + ' ' + item.summary + ' ' + item.keywords).toLowerCase();
                return keywords.every(function (kw) {
                    return haystack.includes(kw);
                });
            });

            statusEl.textContent = 'Found ' + results.length + ' result(s) for "' + rawQuery + '"';

            if (results.length === 0) {
                containerEl.innerHTML = '<div class="bb-sidebar-card"><p style="margin:0;">No matching results found. Try a broader term such as "strand", "decking", "plywood", or "caramel".</p></div>';
                return;
            }

            containerEl.innerHTML = results.map(function (item) {
                var isProd = item.type === 'products';
                var badgeClass = isProd ? 'is-product' : 'is-news';
                var badgeText = isProd ? 'Product' : 'Technical Guide';
                var safeTitle = escapeHtml(item.title);
                var safeSummary = escapeHtml(item.summary);
                var thumbHtml = isProd && item.image
                    ? '<a href="' + item.url + '" class="bb-search-thumb"><img src="' + item.image + '" alt="' + safeTitle + '" loading="lazy" decoding="async" /></a>'
                    : '';

                return (
                    '<article class="bb-search-item' + (isProd ? '' : ' is-news') + '">' +
                        thumbHtml +
                        '<div>' +
                            '<span class="bb-search-badge ' + badgeClass + '">' + badgeText + '</span>' +
                            '<h3><a href="' + item.url + '">' + safeTitle + '</a></h3>' +
                            '<p>' + safeSummary + '</p>' +
                        '</div>' +
                    '</article>'
                );
            }).join('');
        })();
    </script>
</BaseLayout>