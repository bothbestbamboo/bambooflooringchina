---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsSidebar from '../components/NewsSidebar.astro';

// 在构建时自动读取全部产品与新闻数据，生成轻量级搜索索引
const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });

const searchIndex = [
  ...Object.values(productFiles).map((p: any) => ({
    type: 'products',
    title: p.frontmatter.pageTitle || p.frontmatter.title || '',
    url: `/products/${p.frontmatter.slug}.html`,
    summary: p.frontmatter.summary || p.frontmatter.description || '',
    date: p.frontmatter.date || '',
    image: p.frontmatter.images?.[0]?.src || '/img/skin/logo_sml.png',
    keywords: `${p.frontmatter.keywords || ''} ${(p.frontmatter.attributes || []).join(' ')}`
  })),
  ...Object.values(newsFiles).map((n: any) => ({
    type: 'news',
    title: n.frontmatter.title || '',
    url: `/news/${n.frontmatter.slug}.html`,
    summary: n.frontmatter.summary || n.frontmatter.description || '',
    date: n.frontmatter.date || '',
    image: '',
    keywords: n.frontmatter.keywords || ''
  }))
];
---
<BaseLayout
  title="Search Results | Bamboo Flooring: China Factory Wholesale"
  keywords="bamboo flooring, search, products, news"
  description="Search Bothbest bamboo flooring, bamboo decking, bamboo panels products and industry news."
  bodyClass="html not-front not-logged-in one-sidebar sidebar-second page-contact"
  footerType="postscript"
>
    <section class="container mainContent">
        <form action="/search.html" method="get" class="MobileSearch">
            <input type="text" name="MobileSearchKeywords" id="MobileSearchKeywords" placeholder="Search..." />
            <input type="submit" id="MobileSearch" name="MobileSearch" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="tabs">
                <ul class="breadcrumb">
                    <li><a href="/index.html">Home</a> <span class="divider">/</span></li>
                    <li class="active">Search Results</li>
                </ul>
            </div>
        </div>
        <div class="row-fluid">
            <div class="content span9 ">
                <div class="innerSpacer">
                    <a id="main-content"></a>
                    <h1 class="title" id="page-title">Search Results</h1>

                    <!-- 页面内二次搜索框 -->
                    <div style="margin: 15px 0 25px 0; padding: 15px; background: #f9f9f9; border: 1px solid #eee;">
                        <form action="/search.html" method="get" style="margin: 0; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <select name="type" id="page-search-type" style="margin: 0; width: 130px;">
                                <option value="all">All</option>
                                <option value="products">Products</option>
                                <option value="news">News</option>
                            </select>
                            <input type="text" name="SearchKeywords" id="page-search-input" placeholder="Enter keywords..." style="margin: 0; flex: 1; min-width: 180px;" />
                            <input type="submit" value="Search" class="btn btn-success" style="margin: 0;" />
                        </form>
                    </div>

                    <p id="search-status" style="font-weight: bold; margin-bottom: 20px; color: #555;"></p>

                    <div id="block-system-main" class="block block-system">
                        <div class="view view-blog view-id-blog view-display-id-page innerSpacer">
                            <div class="view-content" id="search-results-container">
                                <!-- 搜索结果由下方脚本毫秒级渲染 -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <NewsSidebar />
        </div>
    </section>

    <script is:inline define:vars={{ searchIndex }}>
        (function () {
            const params = new URLSearchParams(window.location.search);
            const rawQuery = (params.get('SearchKeywords') || params.get('MobileSearchKeywords') || '').trim();
            const searchType = (params.get('type') || 'all').toLowerCase();

            // 同步搜索框状态
            const pageInput = document.getElementById('page-search-input');
            const topInput = document.getElementById('SearchKeywords');
            const pageTypeSelect = document.getElementById('page-search-type');
            const topTypeSelect = document.getElementById('type');

            if (pageInput) pageInput.value = rawQuery;
            if (topInput) topInput.value = rawQuery;
            if (pageTypeSelect && (searchType === 'products' || searchType === 'news' || searchType === 'all')) {
                pageTypeSelect.value = searchType;
            }
            if (topTypeSelect && (searchType === 'products' || searchType === 'news')) {
                topTypeSelect.value = searchType;
            }

            const statusEl = document.getElementById('search-status');
            const containerEl = document.getElementById('search-results-container');

            if (!rawQuery) {
                statusEl.textContent = 'Please enter a keyword to search our products and news.';
                return;
            }

            const keywords = rawQuery.toLowerCase().split(/\s+/).filter(Boolean);

            const results = searchIndex.filter(function (item) {
                if (searchType !== 'all' && item.type !== searchType) return false;
                const haystack = (item.title + ' ' + item.summary + ' ' + item.keywords).toLowerCase();
                return keywords.every(function (kw) {
                    return haystack.includes(kw);
                });
            });

            statusEl.textContent = 'Found ' + results.length + ' result(s) for "' + rawQuery + '"';

            if (results.length === 0) {
                containerEl.innerHTML = '<p style="padding: 20px 0;">No matching results found. Please try a broader keyword (e.g., "strand", "decking", "plywood", "caramel").</p>';
                return;
            }

            containerEl.innerHTML = results.map(function (item) {
                const badge = item.type === 'products' ? 'Product' : 'News';
                const thumbHtml = item.image
                    ? '<div class="span2"><a href="' + item.url + '"><img src="' + item.image + '" alt="" style="max-width:100%; height:auto; border:1px solid #ddd; padding:2px;" /></a></div>'
                    : '<div class="span2"><span class="btn btn-inverse postTypeIcon"><i class="icon-pencil icon-white"></i></span></div>';

                return (
                    '<div class="row-fluid post" style="margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px dotted #ccc;">' +
                        '<div class="row-fluid post-content">' +
                            '<div class="row-fluid">' +
                                thumbHtml +
                                '<div class="span10 post-title">' +
                                    '<h3 style="margin-top:0;"><a href="' + item.url + '">' + item.title + '</a> <span class="label" style="font-size:11px; vertical-align:middle;">' + badge + '</span></h3>' +
                                    '<p>' + item.summary + '</p>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>'
                );
            }).join('');
        })();
    </script>
</BaseLayout>