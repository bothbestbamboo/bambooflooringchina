---
import BaseLayout from '../layouts/BaseLayout.astro';

const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const nonEnglishPrefix = /^(fr|de|jp|es|it|ru|nl|pt|ko|ar)-/i;
const nonLatinChars = /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/;

const getCategoryKey = (fm: any): string => {
  const url = String(fm.categoryUrl || '');
  const match = url.match(/product-type-([A-Za-z]+)/i);
  if (match) return match[1];
  const name = String(fm.categoryName || '').toLowerCase();
  if (name.includes('decking')) return 'BambooDecking';
  if (name.includes('panel') || name.includes('plywood') || name.includes('veneer')) return 'BambooPanels';
  if (name.includes('collection') || name.includes('mat') || name.includes('molding')) return 'BambooCollection';
  return 'BambooFlooring';
};

const products = Object.values(productFiles)
  .map((p: any) => {
    const fm = p.frontmatter || {};
    const slug = String(fm.slug || '');
    const rawTitle = String(fm.pageTitle || fm.title || '').replace(/Carbonzied/gi, 'Carbonized');
    const summary = String(fm.summary || fm.description || '').replace(/Carbonzied/gi, 'Carbonized');
    const img = fm.thumb || fm.images?.[0]?.src || '/img/skin/logo_sml.png';
    const imgAlt = fm.images?.[0]?.alt || rawTitle;
    const category = getCategoryKey(fm);
    const dateVal = fm.date ? new Date(fm.date).getTime() : 0;
    const idVal = Number(fm.id) || 0;

    return {
      slug,
      title: rawTitle,
      summary,
      url: `/products/${slug}.html`,
      img,
      imgAlt,
      category,
      dateVal: Number.isNaN(dateVal) ? 0 : dateVal,
      idVal,
    };
  })
  .filter((item) =>
    item.slug &&
    item.title &&
    !item.slug.startsWith('product-type-') &&
    !nonEnglishPrefix.test(item.slug) &&
    !nonLatinChars.test(item.title)
  )
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal));

const countByCat = (key: string) =>
  key === 'all' ? products.length : products.filter((p) => p.category === key).length;

const categories = [
  { key: 'all', label: 'All' },
  { key: 'BambooFlooring', label: 'Bamboo Flooring' },
  { key: 'BambooDecking', label: 'Bamboo Decking' },
  { key: 'BambooPanels', label: 'Bamboo Panels' },
  { key: 'BambooCollection', label: 'Bamboo Collection' },
];
---
<BaseLayout
  title="All Bamboo Products | China Factory Wholesale - Bothbest"
  keywords="bamboo flooring, bamboo decking, bamboo panels, bamboo plywood, bamboo mats, china factory wholesale"
  description="Browse Bothbest complete wholesale catalog of solid bamboo flooring, strand woven bamboo flooring, outdoor bamboo decking, bamboo plywood panels, and bamboo veneer."
  bodyClass="html not-front not-logged-in no-sidebars"
  footerType="simple"
  loadLegacyJs={false}
>
    <section class="container mainContent">
        <form action="/search.html" method="get" class="MobileSearch" role="search">
            <input type="text" name="SearchKeywords" id="MobileSearchKeywords" placeholder="Search products..." aria-label="Search keywords" />
            <input type="submit" id="MobileSearch" name="search" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="content span12">
                <a id="main-content"></a>
                <h1 class="title" id="page-title">Product List</h1>

                <div class="filter-bar" id="productFilters" role="tablist" aria-label="Filter products by category">
                    {categories.map((cat, idx) => (
                        <button
                            type="button"
                            class={`filter-btn${idx === 0 ? ' is-active' : ''}`}
                            data-filter={cat.key}
                            aria-pressed={idx === 0 ? 'true' : 'false'}
                        >
                            {cat.label} <span class="filter-count">({countByCat(cat.key)})</span>
                        </button>
                    ))}
                </div>

                <div class="modern-product-grid" id="productGrid">
                    {products.map((item, idx) => (
                        <article class="portfolioItem product-card" data-category={item.category}>
                            <a href={item.url} class="product-thumb">
                                <img
                                    src={item.img}
                                    width="480"
                                    height="396"
                                    alt={item.imgAlt}
                                    loading={idx < 6 ? 'eager' : 'lazy'}
                                    decoding="async"
                                />
                            </a>
                            <div class="product-card-body">
                                <h2><a href={item.url}>{item.title}</a></h2>
                                <p>{item.summary}</p>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var filterBar = document.getElementById('productFilters');
            var cards = document.querySelectorAll('#productGrid .product-card');
            if (!filterBar) return;

            var applyFilter = function (target) {
                var allBtns = filterBar.querySelectorAll('.filter-btn');
                for (var i = 0; i < allBtns.length; i++) {
                    var active = allBtns[i].getAttribute('data-filter') === target;
                    allBtns[i].classList.toggle('is-active', active);
                    allBtns[i].setAttribute('aria-pressed', active ? 'true' : 'false');
                }
                for (var j = 0; j < cards.length; j++) {
                    var match = target === 'all' || cards[j].getAttribute('data-category') === target;
                    cards[j].style.display = match ? '' : 'none';
                }
            };

            filterBar.addEventListener('click', function (e) {
                var btn = e.target.closest('.filter-btn');
                if (!btn) return;
                applyFilter(btn.getAttribute('data-filter'));
            });
        });
    </script>
</BaseLayout>