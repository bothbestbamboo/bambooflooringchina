<BaseLayout
  title="Bamboo Flooring Clearance : Discount : Special Price : Blowout"
  keywords="bamboo flooring, discount, clearance, blowout, special price"
  description="Discount, clearance, blowout and special pricing for stock bamboo flooring, solid, click, strand woven, engineered and decking."
