---
import BaseLayout from '../../layouts/BaseLayout.astro';

const clearanceItems = [
  { code: 'BB-KC-1409', img: '/img/UploadFiles/null-p1b11sp0ke9ckeju1lhb2dj1bgr1.jpg', desc: 'Horizontal solid bamboo flooring, caramel color', price: 'US$13.00 / m²', size: '980 × 98 × 12mm', qty: '450 m²' },
  { code: 'BB-KC-1401', img: '/img/UploadFiles/null-p198ri6o141uve18md1tu9a1pq31.jpg', desc: 'Strand woven bamboo flooring, natural color', price: 'US$13.90 / m²', size: '1200 × 89 × 10mm', qty: '450 m²' },
  { code: 'BB-KC-1402', img: '/img/UploadFiles/null-p198ri8m8lptcpuu1uqs1f5ap921.jpg', desc: 'Strand woven bamboo flooring, caramel color', price: 'US$13.90 / m²', size: '1200 × 89 × 10mm', qty: '450 m²' },
  { code: 'BB-BKC-1403', img: '/img/UploadFiles/null-p198riajai1mpl1ght13f1k7d7r1.jpg', desc: 'Strand woven bamboo flooring, tiger color', price: 'US$18.80 / m²', size: '920 × 96 × 14mm', qty: '400 m²' },
  { code: 'BB-BKC1404', img: '/img/UploadFiles/null-p198ricrpjaijuuv1i3p1v231non1.jpg', desc: 'Strand woven bamboo flooring, tiger color', price: 'US$19.40 / m²', size: '900 × 92 × 14mm', qty: '400 m²' },
  { code: 'BB-KC-1405', img: '/img/UploadFiles/null-p198riet4d1vp2clul25np414n21.jpg', desc: 'Vertical solid bamboo flooring, natural color', price: 'US$18.80 / m²', size: '960 × 96 × 15mm', qty: '750 m²' },
  { code: 'BB-KC-1406', img: '/img/UploadFiles/null-p198rihu73pt1hsr1n161bs5ju41.jpg', desc: 'Vertical solid bamboo flooring, caramel color', price: 'US$17.30 / m²', size: '960 × 96 × 15mm', qty: '1,300 m²' },
  { code: 'BB-KC-1407', img: '/img/UploadFiles/null-p198riqjb11u90nji1q6i2kn3qs1.jpg', desc: 'Horizontal solid bamboo flooring, caramel color', price: 'US$14.70 / m²', size: '960 × 96 × 15mm', qty: '2,100 m²' },
  { code: 'BB-KC-1408', img: '/img/UploadFiles/null-p198riubfe164vnn1cql1hogjr1.jpg', desc: 'Horizontal solid bamboo flooring, natural color', price: 'US$14.90 / m²', size: '960 × 96 × 15mm', qty: '1,500 m²' },
  { code: 'BB-BKC1401', img: '/img/UploadFiles/null-p198rjp3dcujd1oo71luk1slq16en1.jpg', desc: 'Bamboo plywood panel, vertical, natural, 1 layer', price: 'US$68.60 / sheet', size: '2440 × 1220 × 19mm', qty: '26 sheets' },
];
---
<BaseLayout
  title="Bamboo Flooring Clearance & Factory Overstock Deals | Bothbest"
  keywords="bamboo flooring clearance, wholesale bamboo discount, overstock bamboo flooring, china factory special price"
  description="Factory-direct clearance pricing on A-grade overstock solid bamboo flooring, strand woven bamboo flooring, and bamboo plywood panels ready for shipment."
  bodyClass="html not-front not-logged-in no-sidebars"
  footerType="postscript"
  loadLegacyJs={false}
>
    <section class="container mainContent">
        <form action="/search.html" method="get" class="MobileSearch" role="search">
            <input type="text" name="SearchKeywords" id="MobileSearchKeywords" placeholder="Search clearance..." aria-label="Search keywords" />
            <input type="submit" id="MobileSearch" name="search" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="content span12">
                <a id="main-content"></a>
                <h1 class="title" id="page-title">Factory Clearance &amp; Overstock List</h1>
                <p>For every export production run, Bothbest manufactures approximately 5% extra A-grade volume to guarantee strict color sorting and board selection for our clients.</p>
                <p>When buyers shift to different dimensions or specifications on future orders, these Grade-A overstock lots remain in our warehouse. We offer them at discounted factory-direct prices to clear warehouse space—never because of compromised quality.</p>

                <div class="row-fluid" style="margin-top: 18px;">
                    <div class="span12 clearance-list">
                        <table class="table table-bordered table-striped table-clearance">
                            <thead>
                                <tr>
                                    <th>Item No.</th>
                                    <th style="width: 190px;">Photo</th>
                                    <th>Description</th>
                                    <th>Price (FOB)</th>
                                    <th>Dimensions</th>
                                    <th>Stock Qty</th>
                                    <th style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {clearanceItems.map((item, idx) => (
                                    <tr>
                                        <td><strong>{item.code}</strong></td>
                                        <td class="muted">
                                            <img
                                                src={item.img}
                                                alt={`${item.code} - ${item.desc} (${item.size})`}
                                                loading={idx < 2 ? 'eager' : 'lazy'}
                                                decoding="async"
                                                width="180"
                                                height="135"
                                            />
                                        </td>
                                        <td>{item.desc}</td>
                                        <td class="clearance-price">{item.price}</td>
                                        <td>{item.size}</td>
                                        <td>{item.qty}</td>
                                        <td>
                                            <a
                                                href={`/about.html?product=${encodeURIComponent(`Clearance ${item.code} (${item.size})`)}#RequestAQuote`}
                                                class="btn btn-success btn-small clearance-cta"
                                            >
                                                Inquire
                                            </a>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>