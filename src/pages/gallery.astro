---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Gallery | Bamboo Flooring: China Factory Wholesale"
  keywords="bamboo flooring, china, factory, wholesale"
  description="Bothbest is a China factory manufacturing bamboo flooring and offers bamboo flooring price in wholesale, guaranteed quality, worldwide shipping."
  bodyClass="html not-front not-logged-in one-sidebar sidebar-second page-contact"
  footerType="postscript"
  extraCss={["/css/ctools.css"]}
  extraJs={["/js/Isotope.js"]}
>
    <section class="container mainContent">
        <form action="/search.aspx" method="get" class="MobileSearch">
            <input type="text" name="MobileSearchKeywords" id="MobileSearchKeywords" />
            <input type="submit" id="MobileSearch" name="MobileSearch" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="tabs"></div>
        </div>
        <div class="row-fluid">
            <div class="content span12 ">
                <a id="main-content"></a>
                <h1 class="title" id="page-title">Gallery</h1>
                <div id="block-system-main" class="block block-system">
                    <div class="view view-mentor-portfolio view-id-mentor_portfolio view-display-id-portfolio_6col portfolio-3col view-dom-id-9fbca0cfb3b7cad2b541c9c0b2be7c2c">
                        <div class="view-header clearfix">
                            <div class="view view-mentor-taxonomy view-id-mentor_taxonomy view-display-id-portfolio_filter view-dom-id-ed5de219960d0873163ef6ea6be4f35d">
                                <div class="view-content">
                                    <div id="isotope-options">
                                        <ul id="filters" class="option-set" data-option-key="filter">
                                            <li class="first active"><a href="#filter" data-option-value="*" class="label">All</a></li>
                                            <li><a class="label" data-option-value=".BambooDecking" href="#filter">BambooDecking</a></li>
                                            <li><a class="label" data-option-value=".BambooPanel" href="#filter">BambooPanel</a></li>
                                            <li><a class="label" data-option-value=".BambooFlooring" href="#filter">BambooFlooring</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="view-content">
                            <div id="isotope-container" class="peIsotopeContainer row">
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooDecking" data-category="BambooDecking"><div class="portfolioItem"><a href="/gallery/gallery-detail-41.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1f0iiv5k5c3n1csj1gi71mti65t1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooFlooring" data-category="BambooFlooring"><div class="portfolioItem"><a href="/gallery/gallery-detail-40.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1f0g34em7tk622d1glkf2uqru1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooPanel" data-category="BambooPanel"><div class="portfolioItem"><a href="/gallery/gallery-detail-39.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1f0a69u201e2g1p7015mb98j1isk1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooDecking" data-category="BambooDecking"><div class="portfolioItem"><a href="/gallery/gallery-detail-38.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eqjc7uv53h41m2jf01fpssl41.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooDecking" data-category="BambooDecking"><div class="portfolioItem"><a href="/gallery/gallery-detail-37.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq6hm0881g1is52sgvk0abfi1.JPG" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooDecking" data-category="BambooDecking"><div class="portfolioItem"><a href="/gallery/gallery-detail-36.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq6h8suk161vc2hlp9ehb4f1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
