                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooFlooring" data-category="BambooFlooring"><div class="portfolioItem"><a href="/gallery/gallery-detail-29.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq23j3751mtlsv9hha1kp4ocf1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooPanel" data-category="BambooPanel"><div class="portfolioItem"><a href="/gallery/gallery-detail-28.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq22tebp1dpv1n5c1jmr1qmt4u61.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooFlooring" data-category="BambooFlooring"><div class="portfolioItem"><a href="/gallery/gallery-detail-27.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq22hljo1t7i3cv8cr1tej1a0v1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
                                <div class="span3 peIsotopeItem isotope-element isotope-element-0 BambooPanel" data-category="BambooPanel"><div class="portfolioItem"><a href="/gallery/gallery-detail-26.html" class="peOver"><img typeof="foaf:Image" src="/img/UploadFiles/null-p1eq22h6e51fk31gdfbpupg114hf1.jpg" width="480" height="396" alt="" /><span></span></a></div></div>
