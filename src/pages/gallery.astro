];

const categories = [
  { key: 'all', label: 'All' },
  { key: 'BambooFlooring', label: 'Bamboo Flooring' },
  { key: 'BambooDecking', label: 'Bamboo Decking' },
  { key: 'BambooPanel', label: 'Bamboo Panels' },
];
---
<BaseLayout
  title="Project Gallery | Bothbest Bamboo Flooring, Decking & Panels"
  keywords="bamboo flooring gallery, bamboo decking projects, bamboo panel installations, Bothbest"
  description="Browse real-world residential and commercial installations featuring Bothbest bamboo flooring, outdoor bamboo decking, and bamboo plywood panels."
  bodyClass="html not-front not-logged-in no-sidebars"
  footerType="postscript"
  loadLegacyJs={false}
>
    <section class="container mainContent">
        <form action="/search.html" method="get" class="MobileSearch" role="search">
            <input type="text" name="SearchKeywords" id="MobileSearchKeywords" placeholder="Search bamboo..." aria-label="Search keywords" />
            <input type="submit" id="MobileSearch" name="search" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="content span12">
                <a id="main-content"></a>
                <h1 class="title" id="page-title">Project Gallery</h1>

                <div class="filter-bar" id="galleryFilters" role="tablist" aria-label="Filter gallery by category">
                    {categories.map((cat, idx) => (
                        <button
                            type="button"
                            class={`filter-btn${idx === 0 ? ' is-active' : ''}`}
                            data-filter={cat.key}
                            aria-pressed={idx === 0 ? 'true' : 'false'}
                        >
                            {cat.label}
                        </button>
                    ))}
                </div>

                <div class="modern-gallery-grid" id="galleryGrid">
                    {galleryItems.map((item, idx) => (
                        <article class="portfolioItem gallery-card" data-category={item.category}>
                            <a href={item.href} class="gallery-thumb">
                                <img
                                    src={item.src}
                                    width="480"
                                    height="396"
                                    alt={item.label}
                                    loading={idx < 4 ? 'eager' : 'lazy'}
                                    decoding="async"
                                />
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var filterBar = document.getElementById('galleryFilters');
            var cards = document.querySelectorAll('#galleryGrid .gallery-card');
            if (!filterBar) return;

            filterBar.addEventListener('click', function (e) {
                var btn = e.target.closest('.filter-btn');
                if (!btn) return;
                var target = btn.getAttribute('data-filter');

                var allBtns = filterBar.querySelectorAll('.filter-btn');
                for (var i = 0; i < allBtns.length; i++) {
                    var active = allBtns[i] === btn;
                    allBtns[i].classList.toggle('is-active', active);
                    allBtns[i].setAttribute('aria-pressed', active ? 'true' : 'false');
                }

                for (var j = 0; j < cards.length; j++) {
                    var match = target === 'all' || cards[j].getAttribute('data-category') === target;
                    cards[j].style.display = match ? '' : 'none';
                }
            });
        });
    </script>
</BaseLayout>