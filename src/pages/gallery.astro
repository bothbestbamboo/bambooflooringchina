  { href: '/gallery/gallery-detail-40.html', category: 'BambooFlooring', catLabel: 'Bamboo Flooring', label: 'Indoor Bamboo Flooring Project #40', src: '/img/UploadFiles/null-p1f0g34em7tk622d1glkf2uqru1.jpg' },
