---
import BaseLayout from '../layouts/BaseLayout.astro';

const quickLinks = [
  { label: 'Back to Home', href: '/', primary: true },
  { label: 'All Products', href: '/products.html' },
  { label: 'Project Gallery', href: '/gallery.html' },
  { label: 'Clearance Deals', href: '/clearance/clearance_1.html' },
  { label: 'Request a Quote', href: '/about.html#RequestAQuote' },
];

const categoryLinks = [
  {
    title: 'Bamboo Flooring',
    desc: 'Solid, strand woven, and engineered bamboo flooring',
    href: '/products/product-type-BambooFlooring.html',
  },
  {
    title: 'Bamboo Decking',
    desc: 'High-density outdoor bamboo decking & cladding',
    href: '/products/product-type-BambooDecking.html',
  },
  {
    title: 'Bamboo Panels',
    desc: 'Plywood, countertops, beams & furniture boards',
    href: '/products/product-type-BambooPanels.html',
  },
  {
    title: 'Bamboo Collection',
    desc: 'Veneer, wall panels & custom architectural bamboo',
    href: '/products/product-type-BambooCollection.html',
  },
];
---
<BaseLayout
  title="404 Page Not Found | Bothbest Bamboo Flooring"
  keywords="404, page not found, Bothbest bamboo flooring"
  description="The page you requested could not be found. Search Bothbest bamboo flooring, decking, panels, or explore our product catalog."
  footerType="postscript"
  loadLegacyJs={false}
  isModern={true}
  headHtml='<meta name="robots" content="noindex, nofollow" />'
>
    <section class="bb-404-section">
        <div class="bb-container">
            <div class="bb-404-card">
                <div class="bb-404-code" aria-hidden="true">404</div>
                <h1 class="bb-404-title">Page Not Found</h1>
                <p class="bb-404-desc">
                    Sorry, the page you are looking for may have been moved, renamed, or removed.
                    Search our catalog below or jump directly to one of our main sections.
                </p>

                <form action="/search.html" method="get" class="bb-search-form" style="max-width: 580px;" role="search">
                    <select name="type" aria-label="Search category">
                        <option value="products">Products</option>
                        <option value="news">News</option>
                    </select>
                    <input
                        type="text"
                        name="SearchKeywords"
                        placeholder="Search bamboo flooring, decking, panels..."
                        aria-label="Search keywords"
                        required
                    />
                    <button type="submit" class="bb-btn bb-btn-green">Search</button>
                </form>

                <div class="bb-404-links" aria-label="Quick navigation">
                    {quickLinks.map((link) => (
                        <a
                            href={link.href}
                            class={`bb-btn bb-btn-sm${link.primary ? ' bb-btn-primary' : ' bb-btn-outline-dark'}`}
                        >
                            {link.label}
                        </a>
                    ))}
                </div>

                <div class="bb-404-cats">
                    <h2>Explore Our Bamboo Categories</h2>
                    <div class="bb-404-cat-grid">
                        {categoryLinks.map((cat) => (
                            <a href={cat.href} class="bb-404-cat-card">
                                <strong>{cat.title} &rarr;</strong>
                                <span>{cat.desc}</span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>