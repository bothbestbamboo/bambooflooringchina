---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroSlides = [
  {
    src: '/img/UploadFiles/null-p1epfv1i6adqjbc6pksmgappl1.jpg',
    alt: 'Bothbest China Bamboo Flooring Factory Wholesale',
  },
  {
    src: '/img/UploadFiles/null-p1epfv114317ktc78jf9ikei2i1.jpg',
    alt: 'Bothbest Solid & Strand Woven Bamboo Flooring Collection',
  },
];

const hottestProducts = [
  {
    title: 'Solid Bamboo Flooring',
    href: '/products/solid-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119144871334.jpg',
    alt: 'Solid bamboo flooring planks',
    desc: 'Made from 100% rapidly renewable Moso bamboo in horizontal and vertical grains with tongue-and-groove milling. Available in natural, carbonized, and custom stained finishes.',
  },
  {
    title: 'Wide Plank Bamboo Flooring',
    href: '/products/wide-plank-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119152256770.jpg',
    alt: 'Wide plank 3-layer bamboo flooring',
    desc: 'Long and wide 3-layer cross-laminated bamboo planks engineered for superior dimensional stability, requiring fewer joints and enabling faster installation.',
  },
  {
    title: 'Strand Woven Bamboo Flooring',
    href: '/products/strand-woven-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119155711237.jpg',
    alt: 'High density strand woven bamboo flooring',
    desc: 'High-density (1,050 kg/m³) compressed bamboo flooring offering exceptional indentation resistance and durability for both residential and commercial spaces.',
  },
  {
    title: 'Click Strand Woven Bamboo Flooring',
    href: '/products/click-strand-woven-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119163454583.jpg',
    alt: 'Click lock strand woven bamboo flooring',
    desc: 'Precision-profiled glue-less click-lock strand woven bamboo combining hardwood-like grain aesthetics with fast, floating DIY or contractor installation.',
  },
  {
    title: 'Bamboo Veneer',
    href: '/products/bamboo-veneer.html',
    img: '/img/ThumbPic/2014103119190363525.jpg',
    alt: 'Thin sliced bamboo veneer sheets',
    desc: 'Rotary or flat sliced from laminated bamboo blocks. An eco-friendly alternative to wood veneer featuring consistent grain, wide sheets, and clean machinability.',
  },
  {
    title: 'Bamboo Plywood',
    href: '/products/bamboo-plywood.html',
    img: '/img/ThumbPic/2014103119183766759.jpg',
    alt: 'Multi-layer bamboo plywood panels',
    desc: 'Cross-laminated bamboo panels bonded with low-VOC eco-friendly adhesives in thicknesses from 3mm to 80mm for furniture, cabinetry, and interior architecture.',
  },
];

// 自动读取最新 8 款纯英文产品（过滤 fr-/de-/jp- 等非英文及分类页），并修正历史拼写
const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const nonEnglishPrefix = /^(fr|de|jp|es|it|ru|nl|pt|ko|ar)-/i;
const nonLatinChars = /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/;

const autoNewestProducts = Object.values(productFiles)
  .map((p: any) => {
    const fm = p.frontmatter || {};
    const slug = String(fm.slug || '');
    const rawTitle = String(fm.title || fm.pageTitle || '').replace(/Carbonzied/gi, 'Carbonized');
    const img = fm.thumb || fm.images?.[0]?.src || '';
    const dateVal = fm.date ? new Date(fm.date).getTime() : 0;
    const idVal = Number(fm.id) || 0;
    return {
      slug,
      title: rawTitle,
      href: `/products/${slug}.html`,
      img,
      dateVal: Number.isNaN(dateVal) ? 0 : dateVal,
      idVal,
    };
  })
  .filter((item) =>
    item.slug &&
    item.title &&
    item.img &&
    !item.slug.startsWith('product-type-') &&
    !nonEnglishPrefix.test(item.slug) &&
    !nonLatinChars.test(item.title)
  )
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal))
  .slice(0, 8);

const fallbackNewestProducts = [
  {
    title: 'Solid Bamboo Flooring High Gloss Carbonized',
    href: '/products/bamboo-flooring-high-gloss-carbonized.html',
    img: '/img/ThumbPic/2021012208281913633.jpg',
  },
  {
    title: 'Solid Bamboo Flooring Horizontal Carbonized',
    href: '/products/bamboo-flooring-flat-pressed-carbonized.html',
    img: '/img/ThumbPic/2021012208284063656.jpg',
  },
  {
    title: 'Bamboo Flooring Click Lock Carbonized',
    href: '/products/click-lock-solid-bamboo-flooring-carbonized.html',
    img: '/img/ThumbPic/2021012208385568119.jpg',
  },
  {
    title: 'Bamboo Plywood 20mm Vertical Caramel',
    href: '/products/bamboo-plywood-20mm-vertical-caramel.html',
    img: '/img/ThumbPic/2021012215461392501.jpg',
  },
  {
    title: 'Bamboo Plywood 20mm Vertical Natural',
    href: '/products/bamboo-plywood-20mm-vertical-natural.html',
    img: '/img/ThumbPic/2021012215434773189.jpg',
  },
];

const newestProducts = autoNewestProducts.length >= 4 ? autoNewestProducts : fallbackNewestProducts;

const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Bothbest",
  "url": "https://www.bambooflooringchina.com/",
  "logo": "https://www.bambooflooringchina.com/img/skin/logo.png",
  "description": "China FSC-certified factory manufacturing wholesale bamboo flooring, outdoor bamboo decking, bamboo plywood, and bamboo veneer since 2001.",
  "telephone": "+86-150-0582-0528",
  "email": "info@bambooflooringchina.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tangpu Industrial Zone",
    "addressLocality": "Anji",
    "addressRegion": "Zhejiang",
    "addressCountry": "CN"
  }
});
---
<BaseLayout
  title="Bamboo Flooring: China Factory Wholesale | Bothbest"
  keywords="bamboo flooring, china bamboo factory, wholesale bamboo flooring, bamboo decking, bamboo plywood"
  description="Bothbest is an FSC-certified China factory manufacturing bamboo flooring, outdoor bamboo decking, and bamboo plywood at wholesale prices with worldwide shipping."
  bodyClass="html front not-logged-in no-sidebars page-node"
  footerType="home"
  rssUrl="/rss/products.xml"
  loadLegacyJs={false}
  preloadImage={heroSlides[0].src}
>
    <script is:inline type="application/ld+json" set:html={orgSchema} />

    <section class="prescript taglineWrap">
        <form action="/search.html" method="get" class="MobileSearch" role="search">
            <input type="text" name="SearchKeywords" id="MobileSearchKeywords" placeholder="Search bamboo..." aria-label="Search keywords" />
            <input type="submit" id="MobileSearch" name="search" value="Search" class="form-submit" />
        </form>
        <div class="container">
            <div class="sliderWrap">
                <div class="hero-slider" id="heroSlider" aria-roledescription="carousel" aria-label="Featured Bamboo Flooring">
                    <div class="hero-slides">
                        {heroSlides.map((slide, idx) => (
                            <div class={`hero-slide${idx === 0 ? ' is-active' : ''}`}>
                                <img
                                    src={slide.src}
                                    alt={slide.alt}
                                    fetchpriority={idx === 0 ? 'high' : undefined}
                                    loading={idx === 0 ? 'eager' : 'lazy'}
                                    decoding="async"
                                />
                            </div>
                        ))}
                    </div>
                    {heroSlides.length > 1 && (
                        <>
                            <button type="button" class="hero-nav hero-prev" id="heroPrev" aria-label="Previous slide">&#8249;</button>
                            <button type="button" class="hero-nav hero-next" id="heroNext" aria-label="Next slide">&#8250;</button>
                            <div class="hero-dots" id="heroDots">
                                {heroSlides.map((_, idx) => (
                                    <button
                                        type="button"
                                        class={`hero-dot${idx === 0 ? ' is-active' : ''}`}
                                        data-slide={idx}
                                        aria-label={`Go to slide ${idx + 1}`}
                                    ></button>
                                ))}
                            </div>
                        </>
                    )}
                </div>
            </div>
        </div>
    </section>

    <section class="container mainContent">
        <div class="row-fluid">
            <div class="content span12">
                <a id="main-content"></a>

                <h1 class="sr-only">China Bamboo Flooring, Decking &amp; Plywood Factory — Wholesale Direct</h1>

                <div id="block-block-6" class="block block-block">
                    <div class="row-fluid featuredContent">
                        <div class="span4">
                            <h2 class="section-heading"><span class="btn btn-inverse">01</span> Who we are</h2>
                            <p>Bothbest is an FSC-certified bamboo factory based in China, manufacturing bamboo flooring, decking, and plywood since 2001. Exporting worldwide with a proven reputation, we provide one-stop bamboo sourcing from indoor to outdoor, from floor to ceiling.<br /><br />Recognized as a reliable and trustworthy bamboo supplier, Bothbest partners directly with importers, distributors, architects, designers, contractors, and builders across the globe.</p>
                        </div>
                        <div class="span4">
                            <h2 class="section-heading"><span class="btn btn-inverse">02</span> What we have</h2>
                            <p>Bothbest offers a complete product line with consistent quality and factory-direct pricing, including flooring, decking, panels, plywood, veneer, lumber, mats, countertops, and custom architectural bamboo. All products are CE certified for environmental safety.<br /><br />Flooring covers solid, strand woven, click-lock, and engineered constructions. Outdoor decking includes standard, xtra, and carbonized options. Panels are available from 3mm to 80mm thick.</p>
                        </div>
                        <div class="span4">
                            <h2 class="section-heading"><span class="btn btn-inverse">03</span> Why choose us</h2>
                            <p>Bamboo is one of the world's most sustainable renewable resources due to its rapid growth cycle. As a giant grass, bamboo matures for harvest in 4–6 years compared to 25+ years for traditional hardwoods, growing up to 24 inches in 24 hours.<br /><br />With over two decades of manufacturing expertise, Bothbest delivers guaranteed quality and responsive B2B service—helping you save by buying direct from the factory.</p>
                        </div>
                    </div>
                    <div class="row-fluid">
                        <div class="divider dotted clearfix"><span></span></div>
                    </div>
                </div>

                <div id="bamboo" class="block block-block">
                    <h2 class="section-heading">Hottest Bamboo</h2>
                    <div class="hottest-grid">
                        {hottestProducts.map((item) => (
                            <article class="hottest-card">
                                <a href={item.href} class="hottest-thumb">
                                    <img
                                        src={item.img}
                                        alt={item.alt}
                                        loading="lazy"
                                        decoding="async"
                                        width="300"
                                        height="225"
                                    />
                                </a>
                                <div class="hottest-body">
                                    <h3><a href={item.href}>{item.title}</a></h3>
                                    <p>
                                        {item.desc}
                                        <a href={item.href} class="hottest-more"><span class="label">More</span></a>
                                    </p>
                                </div>
                            </article>
                        ))}
                    </div>
                    <div class="row-fluid">
                        <div class="divider dotted clearfix"><span></span></div>
                    </div>
                </div>

                <div id="block-views-mentor-portfolio-home" class="block block-views">
                    <div class="newest-header">
                        <h2 class="section-heading">Newest Bamboo</h2>
                        <div class="newest-controls">
                            <button type="button" id="newestPrev" class="prev-btn label" aria-label="Previous products">
                                <i class="icon-chevron-left icon-white"></i>
                            </button>
                            <button type="button" id="newestNext" class="next-btn label" aria-label="Next products">
                                <i class="icon-chevron-right icon-white"></i>
                            </button>
                        </div>
                    </div>
                    <div class="newest-viewport" id="newestViewport">
                        <div class="newest-track" id="newestTrack">
                            {newestProducts.map((item) => (
                                <article class="portfolioItem newest-card">
                                    <a href={item.href} class="newest-thumb">
                                        <img
                                            src={item.img}
                                            width="480"
                                            height="396"
                                            alt={item.title}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </a>
                                    <p class="newest-title">
                                        <a href={item.href}>{item.title}</a>
                                    </p>
                                </article>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Hero Banner 轻量轮播（无布局抖动）
            var slider = document.getElementById('heroSlider');
            if (slider) {
                var slides = slider.querySelectorAll('.hero-slide');
                var dots = slider.querySelectorAll('.hero-dot');
                var current = 0;
                var timer = null;

                var showSlide = function (index) {
                    current = (index + slides.length) % slides.length;
                    for (var i = 0; i < slides.length; i++) {
                        slides[i].classList.toggle('is-active', i === current);
                        if (dots[i]) dots[i].classList.toggle('is-active', i === current);
                    }
                };

                var startAuto = function () {
                    if (slides.length <= 1) return;
                    stopAuto();
                    timer = setInterval(function () { showSlide(current + 1); }, 4500);
                };

                var stopAuto = function () {
                    if (timer) { clearInterval(timer); timer = null; }
                };

                var prevBtn = document.getElementById('heroPrev');
                var nextBtn = document.getElementById('heroNext');
                if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); startAuto(); });
                if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); startAuto(); });

                for (var d = 0; d < dots.length; d++) {
                    dots[d].addEventListener('click', function () {
                        showSlide(parseInt(this.getAttribute('data-slide'), 10) || 0);
                        startAuto();
                    });
                }

                slider.addEventListener('mouseenter', stopAuto);
                slider.addEventListener('mouseleave', startAuto);
                startAuto();
            }

            // 2. Newest Bamboo 横向平滑切换
            var viewport = document.getElementById('newestViewport');
            var newestPrev = document.getElementById('newestPrev');
            var newestNext = document.getElementById('newestNext');
            if (viewport && newestPrev && newestNext) {
                var scrollStep = function (dir) {
                    var card = viewport.querySelector('.newest-card');
                    var step = card ? (card.offsetWidth + 16) : 260;
                    if (dir > 0 && viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 8) {
                        viewport.scrollTo({ left: 0, behavior: 'smooth' });
                    } else if (dir < 0 && viewport.scrollLeft <= 8) {
                        viewport.scrollTo({ left: viewport.scrollWidth, behavior: 'smooth' });
                    } else {
                        viewport.scrollBy({ left: dir * step, behavior: 'smooth' });
                    }
                };
                newestPrev.addEventListener('click', function () { scrollStep(-1); });
                newestNext.addEventListener('click', function () { scrollStep(1); });
            }
        });
    </script>
</BaseLayout>