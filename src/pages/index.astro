---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroImage = '/img/hero/bamboo-flooring-hero.jpg';

const hottestProducts = [
  {
    tag: 'Classic Indoor',
    title: 'Solid Bamboo Flooring',
    href: '/products/solid-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119144871334.jpg',
    alt: 'Solid bamboo flooring planks',
    desc: '100% rapidly renewable Moso bamboo in horizontal and vertical grains with tongue-and-groove milling, natural, carbonized, or custom stained finishes.',
  },
  {
    tag: 'Engineered 3-Layer',
    title: 'Wide Plank Bamboo Flooring',
    href: '/products/wide-plank-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119152256770.jpg',
    alt: 'Wide plank 3-layer bamboo flooring',
    desc: 'Cross-laminated wide planks engineered for superior dimensional stability, delivering clean architectural lines with fewer joints and faster installation.',
  },
  {
    tag: 'High Density 1,050+ kg/m³',
    title: 'Strand Woven Bamboo Flooring',
    href: '/products/strand-woven-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119155711237.jpg',
    alt: 'High density strand woven bamboo flooring',
    desc: 'Compressed high-density bamboo planks delivering exceptional indentation resistance and durability for residential and heavy commercial traffic.',
  },
  {
    tag: 'Fast Floating Install',
    title: 'Click Strand Woven Flooring',
    href: '/products/click-strand-woven-bamboo-flooring.html',
    img: '/img/ThumbPic/2014103119163454583.jpg',
    alt: 'Click lock strand woven bamboo flooring',
    desc: 'Precision-profiled glue-less click-lock strand woven planks combining hardwood grain aesthetics with rapid floating installation.',
  },
  {
    tag: 'Surface Finishing',
    title: 'Bamboo Veneer',
    href: '/products/bamboo-veneer.html',
    img: '/img/ThumbPic/2014103119190363525.jpg',
    alt: 'Thin sliced bamboo veneer sheets',
    desc: 'Rotary or flat sliced from laminated bamboo blocks. An eco-friendly wood veneer alternative with consistent grain, wide sheets, and clean machinability.',
  },
  {
    tag: '3mm – 80mm Thickness',
    title: 'Bamboo Plywood',
    href: '/products/bamboo-plywood.html',
    img: '/img/ThumbPic/2014103119183766759.jpg',
    alt: 'Multi-layer bamboo plywood panels',
    desc: 'Cross-laminated bamboo panels bonded with low-VOC adhesives for furniture, cabinetry, countertops, and interior architectural millwork.',
  },
];

const facilityEquipment = [
  {
    badge: 'Automated Workshop',
    title: 'Clean, High-Capacity Production Hall',
    img: '/img/factory/anji-bamboo-factory-line.jpg',
    alt: 'Bothbest automated bamboo flooring manufacturing workshop in Anji',
    desc: 'Centralized dust-extraction systems and automated material handling keep every batch clean, uniform, and ready for container export.',
  },
  {
    badge: 'Hot Pressing',
    title: 'Multi-Layer Hydraulic Hot Presses',
    img: '/img/factory/hydraulic-hot-press.jpg',
    alt: 'Multi-layer high-tonnage hydraulic hot press for strand woven bamboo',
    desc: 'High-tonnage hydraulic pressing fuses bamboo fibers and low-VOC resin into ultra-dense billets exceeding 1,050 kg/m³.',
  },
  {
    badge: 'Precision Milling',
    title: 'Automated CNC & Profiling Lines',
    img: '/img/factory/automated-profiling-line.jpg',
    alt: 'Automated CNC profiling and sanding line for bamboo planks',
    desc: 'Precision tongue-and-groove and click-lock milling ensures tight seams, accurate tolerances, and smooth job-site installation.',
  },
];

const cleanDisplayTitle = (raw: string) =>
  raw
    .replace(/Carbonzied/gi, 'Carbonized')
    .split('|')[0]
    .replace(/\s*:\s*$/g, '')
    .replace(/\s*:\s*/g, ' — ')
    .trim();

const productFiles = import.meta.glob('../data/products/*.md', { eager: true });
const nonEnglishPrefix = /^(fr|de|jp|es|it|ru|nl|pt|ko|ar)-/i;
const nonLatinChars = /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/;

const autoNewestProducts = Object.values(productFiles)
  .map((p: any) => {
    const fm = p.frontmatter || {};
    const slug = String(fm.slug || '');
    const rawTitle = String(fm.title || fm.pageTitle || '');
    const img = fm.thumb || fm.images?.[0]?.src || '';
    const dateVal = fm.date ? new Date(fm.date).getTime() : 0;
    const idVal = Number(fm.id) || 0;
    return {
      slug,
      title: cleanDisplayTitle(rawTitle),
      href: `/products/${slug}.html`,
      img,
      dateVal: Number.isNaN(dateVal) ? 0 : dateVal,
      idVal,
    };
  })
  .filter((item) =>
    item.slug &&
    item.title &&
    item.img &&
    !item.slug.startsWith('product-type-') &&
    !nonEnglishPrefix.test(item.slug) &&
    !nonLatinChars.test(item.title)
  )
  .sort((a, b) => (b.dateVal - a.dateVal) || (b.idVal - a.idVal))
  .slice(0, 8);

const fallbackNewestProducts = [
  {
    title: 'Solid Bamboo Flooring High Gloss Carbonized',
    href: '/products/bamboo-flooring-high-gloss-carbonized.html',
    img: '/img/ThumbPic/2021012208281913633.jpg',
  },
  {
    title: 'Solid Bamboo Flooring Horizontal Carbonized',
    href: '/products/bamboo-flooring-flat-pressed-carbonized.html',
    img: '/img/ThumbPic/2021012208284063656.jpg',
  },
  {
    title: 'Bamboo Flooring Click Lock Carbonized',
    href: '/products/click-lock-solid-bamboo-flooring-carbonized.html',
    img: '/img/ThumbPic/2021012208385568119.jpg',
  },
  {
    title: 'Bamboo Plywood 20mm Vertical Caramel',
    href: '/products/bamboo-plywood-20mm-vertical-caramel.html',
    img: '/img/ThumbPic/2021012215461392501.jpg',
  },
];

const newestProducts = autoNewestProducts.length >= 4 ? autoNewestProducts : fallbackNewestProducts;

const newsFiles = import.meta.glob('../data/news/*.md', { eager: true });
const latestNews = Object.values(newsFiles)
  .sort((a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0))
  .slice(0, 3)
  .map((n: any) => {
    const rawDate = String(n.frontmatter.date || '').split(' ')[0];
    return {
      title: n.frontmatter.title || '',
      summary: n.frontmatter.summary || '',
      href: `/news/${n.frontmatter.slug}.html`,
      date: rawDate,
    };
  });

const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Bothbest",
  "url": "https://www.bambooflooringchina.com/",
  "logo": "https://www.bambooflooringchina.com/img/skin/newlogo2.png",
  "description": "China FSC-certified factory manufacturing wholesale bamboo flooring, outdoor bamboo decking, bamboo plywood, and bamboo veneer since 2001.",
  "telephone": "+86-150-0582-0528",
  "email": "info@bambooflooringchina.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tangpu Industrial Zone",
    "addressLocality": "Anji",
    "addressRegion": "Zhejiang",
    "addressCountry": "CN"
  }
});
---
<BaseLayout
  title="Bamboo Flooring: China Factory Wholesale | Bothbest"
  keywords="bamboo flooring, china bamboo factory, wholesale bamboo flooring, bamboo decking, bamboo plywood"
  description="Bothbest is an FSC-certified China factory manufacturing bamboo flooring, outdoor bamboo decking, and bamboo plywood at wholesale prices with worldwide shipping."
  footerType="home"
  loadLegacyJs={false}
  isModern={true}
  preloadImage={heroImage}
>
    <script is:inline type="application/ld+json" set:html={orgSchema} />

    <!-- 1. Hero Banner -->
    <section class="bb-hero">
        <img
            src={heroImage}
            alt="Bothbest China Bamboo Flooring & Outdoor Decking Factory"
            class="bb-hero-bg"
            fetchpriority="high"
            loading="eager"
            decoding="async"
        />
        <div class="bb-hero-overlay" aria-hidden="true"></div>
        <div class="bb-container">
            <div class="bb-hero-content">
                <div class="bb-hero-badge">FSC &amp; CE Certified Manufacturer &middot; Since 2001</div>
                <h1 class="bb-hero-title">Factory-Direct Bamboo Flooring, Decking &amp; Panels</h1>
                <p class="bb-hero-desc">
                    Anji’s specialist bamboo factory supplying importers, distributors, architects, and builders worldwide with consistent quality and wholesale pricing.
                </p>
                <div class="bb-hero-actions">
                    <a href="/about.html#RequestAQuote" class="bb-btn bb-btn-primary">Request Wholesale Quote</a>
                    <a href="/products.html" class="bb-btn bb-btn-outline-light">Explore Products</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Trust Credentials Strip -->
    <section class="bb-trust-wrap" aria-label="Factory credentials">
        <div class="bb-container">
            <div class="bb-trust-grid">
                <div class="bb-trust-item">
                    <div class="bb-trust-value">25+ Years</div>
                    <div class="bb-trust-label">Bamboo manufacturing experience since 2001</div>
                </div>
                <div class="bb-trust-item">
                    <div class="bb-trust-value">FSC &amp; CE</div>
                    <div class="bb-trust-label">Certified sustainable forestry &amp; EU safety</div>
                </div>
                <div class="bb-trust-item">
                    <div class="bb-trust-value">3mm – 80mm</div>
                    <div class="bb-trust-label">Full range of flooring, decking &amp; panels</div>
                </div>
                <div class="bb-trust-item">
                    <div class="bb-trust-value">Worldwide</div>
                    <div class="bb-trust-label">Direct container export to 40+ countries</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Featured Bamboo Collections -->
    <section class="bb-section">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Core Product Range</span>
                    <h2 class="bb-section-title">Featured Bamboo Collections</h2>
                    <p class="bb-section-sub">One-stop bamboo sourcing from indoor flooring to panels and exterior decking.</p>
                </div>
                <a href="/products.html" class="bb-link-arrow">
                    <span>View All Products</span>
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <div class="bb-product-grid">
                {hottestProducts.map((item) => (
                    <article class="bb-product-card">
                        <a href={item.href} class="bb-product-thumb">
                            <img src={item.img} alt={item.alt} loading="lazy" decoding="async" width="680" height="420" />
                            <span class="bb-product-tag">{item.tag}</span>
                        </a>
                        <div class="bb-product-body">
                            <h3><a href={item.href}>{item.title}</a></h3>
                            <p>{item.desc}</p>
                            <a href={item.href} class="bb-card-cta">
                                <span>Explore Specifications</span>
                                <span aria-hidden="true">&rarr;</span>
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- 4. Factory Strength & B2B Value -->
    <section class="bb-section bb-section-warm">
        <div class="bb-container bb-factory-grid">
            <div>
                <span class="bb-eyebrow">Why Partner With Bothbest</span>
                <h2 class="bb-section-title">Built for Importers, Distributors &amp; Projects</h2>
                <p class="bb-section-sub">
                    Located in Anji—China’s Moso bamboo heartland—we control every step from raw stalk selection and kiln drying to CNC profiling and strict VOC inspection.
                </p>

                <div class="bb-pillar-list">
                    <div class="bb-pillar">
                        <div class="bb-pillar-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/>
                            </svg>
                        </div>
                        <div>
                            <h3>Complete Indoor-to-Outdoor Supply</h3>
                            <p>Solid, strand woven, engineered click flooring, thermo-treated outdoor decking, veneer, countertops, and custom architectural panels.</p>
                        </div>
                    </div>

                    <div class="bb-pillar">
                        <div class="bb-pillar-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                <path d="m9 12 2 2 4-4"/>
                            </svg>
                        </div>
                        <div>
                            <h3>Rapidly Renewable &amp; Low-VOC Certified</h3>
                            <p>Moso bamboo matures in 4–6 years versus 25+ years for hardwood. All collections meet strict European CE and environmental safety benchmarks.</p>
                        </div>
                    </div>

                    <div class="bb-pillar">
                        <div class="bb-pillar-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <div>
                            <h3>Factory-Direct Pricing &amp; OEM Flexibility</h3>
                            <p>Cut out middlemen with transparent wholesale quotes, custom colors, private-label packaging, and reliable global shipping schedules.</p>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="bb-spec-panel">
                <h3>Manufacturing Snapshot</h3>
                <p>Precision profiling lines, high-tonnage hydraulic hot presses, and in-house quality testing labs ensure repeatable container-to-container consistency.</p>
                <ul class="bb-spec-list">
                    <li>
                        <span class="bb-spec-key">Factory Location</span>
                        <span class="bb-spec-val">Anji, Zhejiang, China</span>
                    </li>
                    <li>
                        <span class="bb-spec-key">Established</span>
                        <span class="bb-spec-val">2001 (25+ Years Export)</span>
                    </li>
                    <li>
                        <span class="bb-spec-key">Strand Woven Density</span>
                        <span class="bb-spec-val">1,050 – 1,200 kg/m³</span>
                    </li>
                    <li>
                        <span class="bb-spec-key">Panel Thickness Range</span>
                        <span class="bb-spec-val">3mm to 80mm Custom</span>
                    </li>
                    <li>
                        <span class="bb-spec-key">Core B2B Clients</span>
                        <span class="bb-spec-val">Importers, Wholesalers, Contractors</span>
                    </li>
                </ul>
                <div class="bb-cert-badges">
                    <span class="bb-cert-badge">FSC Certified</span>
                    <span class="bb-cert-badge">CE Compliant</span>
                    <span class="bb-cert-badge">Low-VOC E1/E0</span>
                </div>
                <a href="/about.html" class="bb-btn bb-btn-primary" style="width: 100%;">Explore Our Factory &rarr;</a>
            </aside>
        </div>
    </section>

    <!-- 5. Production Facility & Equipment Showcase -->
    <section class="bb-section">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Inside Our Anji Plant</span>
                    <h2 class="bb-section-title">Production Facility &amp; Equipment</h2>
                    <p class="bb-section-sub">Automated pressing, precision CNC profiling, and in-house quality inspection.</p>
                </div>
                <a href="/about.html" class="bb-link-arrow">
                    <span>Full Factory Tour</span>
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <div class="bb-facility-grid">
                {facilityEquipment.map((item) => (
                    <article class="bb-facility-card">
                        <div class="bb-facility-thumb">
                            <img src={item.img} alt={item.alt} loading="lazy" decoding="async" width="1200" height="800" />
                            <span class="bb-facility-badge">{item.badge}</span>
                        </div>
                        <div class="bb-facility-body">
                            <h3>{item.title}</h3>
                            <p>{item.desc}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- 6. Newest Bamboo Arrivals -->
    <section class="bb-section bb-section-warm">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Recently Added</span>
                    <h2 class="bb-section-title">Latest Bamboo Arrivals</h2>
                </div>
                <div class="bb-carousel-controls">
                    <button type="button" id="newestPrev" class="bb-carousel-btn" aria-label="Previous products">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <button type="button" id="newestNext" class="bb-carousel-btn" aria-label="Next products">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                </div>
            </div>

            <div class="bb-carousel-viewport" id="newestViewport">
                <div class="bb-carousel-track">
                    {newestProducts.map((item) => (
                        <article class="bb-arrival-card">
                            <a href={item.href} class="bb-arrival-thumb">
                                <img src={item.img} width="480" height="396" alt={item.title} loading="lazy" decoding="async" />
                            </a>
                            <div class="bb-arrival-body">
                                <h3 class="bb-arrival-title">
                                    <a href={item.href}>{item.title}</a>
                                </h3>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- 7. Latest Technical Guides & Industry News -->
    <section class="bb-section">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Knowledge Base</span>
                    <h2 class="bb-section-title">Technical Guides &amp; Insights</h2>
                    <p class="bb-section-sub">Installation specs, durability testing, and buying guidance from our production specialists.</p>
                </div>
                <a href="/news/news_1.html" class="bb-link-arrow">
                    <span>All Articles</span>
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <div class="bb-news-grid">
                {latestNews.map((post) => (
                    <article class="bb-news-card">
                        {post.date && <div class="bb-news-date">{post.date}</div>}
                        <h3><a href={post.href}>{post.title}</a></h3>
                        <p>{post.summary}</p>
                        <a href={post.href} class="bb-card-cta">
                            <span>Read Guide</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var viewport = document.getElementById('newestViewport');
            var prevBtn = document.getElementById('newestPrev');
            var nextBtn = document.getElementById('newestNext');
            if (!viewport || !prevBtn || !nextBtn) return;

            var scrollStep = function (dir) {
                var card = viewport.querySelector('.bb-arrival-card');
                var step = card ? (card.offsetWidth + 22) : 300;
                if (dir > 0 && viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 8) {
                    viewport.scrollTo({ left: 0, behavior: 'smooth' });
                } else if (dir < 0 && viewport.scrollLeft <= 8) {
                    viewport.scrollTo({ left: viewport.scrollWidth, behavior: 'smooth' });
                } else {
                    viewport.scrollBy({ left: dir * step, behavior: 'smooth' });
                }
            };

            prevBtn.addEventListener('click', function () { scrollStep(-1); });
            nextBtn.addEventListener('click', function () { scrollStep(1); });
        });
    </script>
</BaseLayout>