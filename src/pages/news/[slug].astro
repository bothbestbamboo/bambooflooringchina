---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';

export async function getStaticPaths() {
  const newsFiles = import.meta.glob('../../data/news/*.md', { eager: true });
  const sortedNews = Object.values(newsFiles).sort(
    (a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0)
  );

  return sortedNews.map((post: any, index: number) => {
    const prevPost = sortedNews[index + 1] as any;
    const nextPost = sortedNews[index - 1] as any;
    return {
      params: { slug: post.frontmatter.slug },
      props: {
        post,
        prevUrl: prevPost ? `/news/${prevPost.frontmatter.slug}.html` : '',
        nextUrl: nextPost ? `/news/${nextPost.frontmatter.slug}.html` : ''
      }
    };
  });
}

const { post, prevUrl, nextUrl } = Astro.props;
const { frontmatter, Content } = post;
const dateStr = String(frontmatter.date || '').split(' ')[0];

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.description || frontmatter.summary || '',
  "datePublished": frontmatter.date || undefined,
  "author": {
    "@type": "Organization",
    "name": "Bothbest"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bothbest",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.bambooflooringchina.com/img/skin/newlogo2.png"
    }
  }
});
---
<BaseLayout
  title={frontmatter.title}
  keywords={frontmatter.keywords}
  description={frontmatter.description}
  footerType="postscript"
  loadLegacyJs={false}
  isModern={true}
>
    <script is:inline type="application/ld+json" set:html={articleSchema} />

    <div class="bb-pd-crumb-bar">
        <div class="bb-container">
            <ol class="bb-breadcrumb">
                <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
                <li><a href="/news/news_1.html">News</a><span class="bb-breadcrumb-sep">/</span></li>
                <li aria-current="page">{frontmatter.title}</li>
            </ol>
        </div>
    </div>

    <section class="bb-main-section">
        <div class="bb-container bb-two-col">
            <article class="bb-article-card">
                <header class="bb-article-header">
                    <span class="bb-eyebrow">Technical Knowledge</span>
                    <h1 class="bb-article-title">{frontmatter.title}</h1>
                    <div class="bb-article-meta">
                        {dateStr && <span>Published: {dateStr}</span>}
                        <span>By Bothbest Technical Team</span>
                    </div>
                </header>

                <div class="bb-article-prose">
                    <Content />
                </div>

                <nav class="bb-article-nav" aria-label="Adjacent posts">
                    <div>
                        {prevUrl && (
                            <a href={prevUrl} class="bb-btn bb-btn-outline-dark bb-btn-sm">&larr; Previous Guide</a>
                        )}
                    </div>
                    <div>
                        {nextUrl && (
                            <a href={nextUrl} class="bb-btn bb-btn-outline-dark bb-btn-sm">Next Guide &rarr;</a>
                        )}
                    </div>
                </nav>
            </article>

            <NewsSidebar />
        </div>
    </section>
</BaseLayout>