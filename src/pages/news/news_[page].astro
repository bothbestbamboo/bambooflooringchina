---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';

const newsBannerImage = '/img/hero/news-banner.jpg';

export async function getStaticPaths({ paginate }: any) {
  const newsFiles = import.meta.glob('../../data/news/*.md', { eager: true });
  const sortedNews = Object.values(newsFiles).sort(
    (a: any, b: any) => (b.frontmatter.id || 0) - (a.frontmatter.id || 0)
  );
  return paginate(sortedNews, { pageSize: 20 });
}

const { page } = Astro.props as any;
const currentPage = page.currentPage;
const totalPages = page.lastPage;

const startPage = Math.max(1, Math.min(currentPage - 4, totalPages - 8));
const endPage = Math.min(totalPages, Math.max(9, currentPage + 4));
const pageNumbers = Array.from({ length: endPage - startPage + 1 }, (_, i) => startPage + i);

const pageTitle = currentPage > 1
  ? `Bamboo Flooring News & Guides - Page ${currentPage} | Bothbest`
  : `Bamboo Flooring News & Technical Guides | Bothbest`;
const pageDesc = currentPage > 1
  ? `Page ${currentPage} of Bothbest bamboo flooring, outdoor decking, and bamboo plywood industry news, installation guides, and factory insights.`
  : `Technical guides, installation tips, and industry updates on bamboo flooring, outdoor bamboo decking, and bamboo plywood from Bothbest China factory.`;
---
<BaseLayout
  title={pageTitle}
  keywords="bamboo flooring news, bamboo decking guide, bamboo plywood tips, Bothbest blog"
  description={pageDesc}
  footerType="postscript"
  loadLegacyJs={false}
  isModern={true}
  preloadImage={newsBannerImage}
>
    <section class="bb-page-hero bb-page-hero--banner">
        <img
            src={newsBannerImage}
            alt="Bothbest Bamboo Flooring Technical Guides & News"
            class="bb-page-hero-bg"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            onerror="this.style.display='none'"
        />
        <div class="bb-page-hero-overlay" aria-hidden="true"></div>
        <div class="bb-container">
            <ol class="bb-breadcrumb">
                <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
                <li aria-current="page">News &amp; Technical Guides</li>
            </ol>
            <h1 class="bb-page-title">Bamboo Blog &amp; Technical Guides</h1>
            <p class="bb-page-lead">
                Practical specifications, installation engineering, durability test comparisons, and industry insights from our manufacturing team.
            </p>
        </div>
    </section>

    <section class="bb-main-section">
        <div class="bb-container bb-two-col">
            <div>
                <div class="bb-news-list">
                    {page.data.map((post: any, idx: number) => {
                        const fm = post.frontmatter || {};
                        const dateStr = String(fm.date || '').split(' ')[0];
                        const coverImg = fm.image || fm.cover || fm.thumb || '';
                        const postHref = `/news/${fm.slug}.html`;
                        return (
                            <article class={`bb-news-row${coverImg ? ' has-thumb' : ''}`}>
                                {coverImg && (
                                    <a href={postHref} class="bb-news-row-thumb">
                                        <img
                                            src={coverImg}
                                            alt={fm.title || ''}
                                            loading={idx < 4 ? 'eager' : 'lazy'}
                                            decoding="async"
                                            width="480"
                                            height="300"
                                            onerror="var r=this.closest('.has-thumb');if(r)r.classList.remove('has-thumb');this.parentElement.remove();"
                                        />
                                    </a>
                                )}
                                <div class={coverImg ? 'bb-news-row-body' : undefined}>
                                    <div class="bb-news-meta">
                                        <span>Technical Guide</span>
                                        {dateStr && <span>&middot; {dateStr}</span>}
                                    </div>
                                    <h2><a href={postHref}>{fm.title}</a></h2>
                                    {fm.summary && <p>{fm.summary}</p>}
                                    <a href={postHref} class="bb-card-cta">
                                        <span>Read Full Guide</span>
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>
                                </div>
                            </article>
                        );
                    })}
                </div>

                <nav class="bb-pagination" aria-label="News pagination">
                    {currentPage > 1 && (
                        <>
                            <a class="bb-page-link" href="/news/news_1.html">First</a>
                            <a class="bb-page-link" href={`/news/news_${currentPage - 1}.html`}>&larr; Prev</a>
                        </>
                    )}
                    {pageNumbers.map((num) => (
                        <a
                            href={`/news/news_${num}.html`}
                            class={`bb-page-link${num === currentPage ? ' is-active' : ''}`}
                            aria-current={num === currentPage ? 'page' : undefined}
                        >
                            {num}
                        </a>
                    ))}
                    {currentPage < totalPages && (
                        <>
                            <a class="bb-page-link" href={`/news/news_${currentPage + 1}.html`}>Next &rarr;</a>
                            <a class="bb-page-link" href={`/news/news_${totalPages}.html`}>Last</a>
                        </>
                    )}
                </nav>
            </div>

            <NewsSidebar />
        </div>
    </section>
</BaseLayout>