---
import BaseLayout from '../layouts/BaseLayout.astro';

const factorySlides = [
  { src: '/img/factory/anji-bamboo-factory-line.jpg', alt: 'Bothbest automated bamboo manufacturing hall in Anji' },
  { src: '/img/factory/hydraulic-hot-press.jpg', alt: 'Multi-layer hydraulic hot press for high-density strand woven bamboo' },
  { src: '/img/factory/automated-profiling-line.jpg', alt: 'Automated CNC tongue-and-groove profiling and sanding line' },
  { src: '/img/UploadFiles/null-p192tir36vdbs11u31jl01r0l1d101.jpg', alt: 'Bothbest bamboo flooring production line' },
  { src: '/img/UploadFiles/null-p192tiqdfpf798vp1nf6f761vfq1.jpg', alt: 'Bamboo strip pressing and lamination workshop' },
  { src: '/img/UploadFiles/null-p192tipk50m2pkskdm0m41kkd1.jpg', alt: 'Automated bamboo flooring UV coating line' },
  { src: '/img/UploadFiles/null-p192tipa6imh112681v7rh4t11qm1.jpg', alt: 'Bamboo flooring quality inspection and sorting' },
  { src: '/img/UploadFiles/null-p192tiokaie4b1umk1oif136v11sj1.jpg', alt: 'Export-ready wholesale bamboo flooring warehouse' },
];

const exportRegions = [
  {
    region: 'Europe',
    countries: 'Germany, France, Italy, Spain, Portugal, Belgium, Netherlands, Denmark, Norway, Sweden, Switzerland, UK, Russia, Slovakia, Poland, Austria, Kosovo, Turkey',
  },
  {
    region: 'North America',
    countries: 'United States, Canada, Mexico',
  },
  {
    region: 'Asia & Middle East',
    countries: 'South Korea, Japan, India, Sri Lanka, Maldives, Singapore, Philippines, Brunei, Malaysia, Saudi Arabia, UAE',
  },
  {
    region: 'South America',
    countries: 'Panama, Colombia, Brazil, Chile, Argentina',
  },
  {
    region: 'Oceania',
    countries: 'Australia, New Zealand',
  },
  {
    region: 'Africa',
    countries: 'South Africa, Nigeria, Morocco',
  },
];
---
<BaseLayout
  title="About Bothbest | China Bamboo Flooring & Panels Factory"
  keywords="bamboo flooring factory, bamboo panels manufacturer, china bamboo wholesaler, Bothbest"
  description="Learn about Bothbest, an FSC-certified China factory manufacturing and exporting wholesale bamboo flooring, decking, and panels worldwide since 2001."
  footerType="simple"
  loadLegacyJs={false}
  isModern={true}
>
    <!-- 1. Sub-Hero -->
    <section class="bb-page-hero bb-page-hero--dark">
        <div class="bb-container">
            <ol class="bb-breadcrumb">
                <li><a href="/">Home</a><span class="bb-breadcrumb-sep">/</span></li>
                <li aria-current="page">About Factory</li>
            </ol>
            <h1 class="bb-page-title">About Bothbest Bamboo</h1>
            <p class="bb-page-lead">
                Anji-based specialist bamboo manufacturer since 2001, supplying importers, distributors, architects, and project contractors across 40+ countries.
            </p>
            <div class="bb-hero-stats">
                <span class="bb-hero-stat-pill"><strong>Since 2001</strong> Factory Direct</span>
                <span class="bb-hero-stat-pill"><strong>ISO 9001 &amp; 14001</strong> Certified</span>
                <span class="bb-hero-stat-pill"><strong>FSC &amp; CE</strong> Compliant</span>
                <span class="bb-hero-stat-pill"><strong>40+ Countries</strong> Exported</span>
            </div>
        </div>
    </section>

    <!-- 2. Company Story & Eco Mission -->
    <section class="bb-section">
        <div class="bb-container bb-about-grid">
            <div class="bb-about-prose">
                <span class="bb-eyebrow">Source Manufacturer</span>
                <h2 class="bb-section-title" style="margin-bottom: 18px;">Dedicated Exclusively to Rapidly Renewable Bamboo</h2>
                <p>
                    Bothbest is a China-based manufacturer focusing exclusively on Moso bamboo building materials. We produce a complete product portfolio including solid and strand woven bamboo flooring, thermo-treated outdoor bamboo decking, multi-layer bamboo plywood panels, veneer, and custom architectural bamboo.
                </p>
                <p>
                    Our manufacturing base sits in Anji, Zhejiang—China’s core Moso bamboo heartland—where mature bamboo forests are harvested sustainably on a rotating cycle. Equipped with automated precision profiling lines, high-tonnage hydraulic hot presses, and strict VOC testing protocols, we deliver stable, wear-resistant boards trusted across Europe, North America, and Australia.
                </p>
                <p>
                    Bothbest operates under ISO 9001 quality management and ISO 14001 environmental management standards, ensuring repeatable consistency from sample approval to full container shipment.
                </p>
                <div class="bb-cert-row">
                    <span class="bb-cert-tag">ISO 9001 Quality</span>
                    <span class="bb-cert-tag">ISO 14001 Environment</span>
                    <span class="bb-cert-tag">FSC Certified</span>
                    <span class="bb-cert-tag">CE Low-VOC</span>
                </div>
            </div>

            <aside class="bb-mission-card">
                <span class="bb-eyebrow">Sustainability</span>
                <h2>Our Eco Mission</h2>
                <p>
                    Our mission is to manufacture durable, non-toxic, and ecologically sustainable bamboo building materials that deliver factory-direct value and responsive service to global distributors, architects, builders, and homeowners.
                </p>
                <p>
                    Because Moso bamboo matures for harvest in 4–6 years compared to 25+ years for traditional hardwoods, maximizing bamboo utilization actively reduces slow-growth timber logging while providing superior structural hardness.
                </p>
            </aside>
        </div>
    </section>

    <!-- 3. Factory Tour Slider -->
    <section class="bb-section bb-section-warm">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Inside Our Facility</span>
                    <h2 class="bb-section-title">Factory Tour &amp; Production Lines</h2>
                    <p class="bb-section-sub">Automated pressing, CNC profiling, UV coating, quality sorting, and export warehousing.</p>
                </div>
            </div>

            <div class="bb-tour-frame">
                <div class="bb-slider" id="factorySlider" aria-roledescription="carousel" aria-label="Bothbest Factory Tour">
                    <div class="bb-slides">
                        {factorySlides.map((slide, idx) => (
                            <div class={`bb-slide${idx === 0 ? ' is-active' : ''}`} data-caption={slide.alt}>
                                <img
                                    src={slide.src}
                                    alt={slide.alt}
                                    loading={idx === 0 ? 'eager' : 'lazy'}
                                    decoding="async"
                                    width="1200"
                                    height="800"
                                />
                            </div>
                        ))}
                    </div>
                    <button type="button" class="bb-slider-btn bb-slider-prev" id="factoryPrev" aria-label="Previous photo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <button type="button" class="bb-slider-btn bb-slider-next" id="factoryNext" aria-label="Next photo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                    <div class="bb-slider-dots" id="factoryDots">
                        {factorySlides.map((_, idx) => (
                            <button
                                type="button"
                                class={`bb-slider-dot${idx === 0 ? ' is-active' : ''}`}
                                data-slide={idx}
                                aria-label={`View photo ${idx + 1}`}
                            ></button>
                        ))}
                    </div>
                </div>
                <div class="bb-tour-caption">
                    <span id="factoryCaption">{factorySlides[0].alt}</span>
                    <span class="bb-tour-counter" id="factoryCounter">1 / {factorySlides.length}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Global Export Footprint -->
    <section class="bb-section">
        <div class="bb-container">
            <div class="bb-section-head">
                <div>
                    <span class="bb-eyebrow">Worldwide Logistics</span>
                    <h2 class="bb-section-title">Global Sales Network</h2>
                    <p class="bb-section-sub">Exporting container-direct bamboo flooring, decking, and panels to 40+ countries since 2001.</p>
                </div>
            </div>

            <div class="bb-export-map">
                <img src="/img/skin/map1.jpg" alt="Bothbest Global Bamboo Flooring Export Map" loading="lazy" decoding="async" />
            </div>

            <div class="bb-region-grid">
                {exportRegions.map((item) => (
                    <div class="bb-region-card">
                        <h3>{item.region}</h3>
                        <p>{item.countries}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 5. Request A Quote & Factory Contact -->
    <section class="bb-section bb-section-warm bb-quote-anchor" id="RequestAQuote">
        <div class="bb-container bb-quote-grid">
            <div class="bb-quote-card">
                <span class="bb-eyebrow">Direct Factory Inquiry</span>
                <h2 class="bb-section-title">Request A Wholesale Quote</h2>
                <p class="bb-section-sub">Tell us your required product specs, dimensions, or container volume. We respond within 24 hours.</p>

                <form action="https://api.web3forms.com/submit" method="POST" id="contact-site-form" accept-charset="UTF-8">
                    <input type="hidden" name="access_key" value="81ff5088-e596-4b27-851b-cbaf5ab4a4f9" />
                    <input type="hidden" name="subject" value="New Product Quote Inquiry - Bothbest" />
                    <input type="hidden" name="from_name" value="Bothbest Quote Form" />

                    <div class="bb-form-grid">
                        <div class="bb-field">
                            <label for="edit-name">Your Name <span class="bb-req">*</span></label>
                            <input type="text" id="edit-name" name="name" maxlength="255" placeholder="John Smith" required />
                        </div>
                        <div class="bb-field">
                            <label for="edit-product">Product of Interest <span class="bb-req">*</span></label>
                            <input type="text" id="edit-product" name="product" maxlength="255" placeholder="e.g. Strand Woven Bamboo Flooring" required />
                        </div>
                        <div class="bb-field">
                            <label for="edit-mail">Business Email <span class="bb-req">*</span></label>
                            <input type="email" id="edit-mail" name="email" maxlength="255" placeholder="name@company.com" required />
                        </div>
                        <div class="bb-field">
                            <label for="edit-tel">Phone / WhatsApp <span class="bb-req">*</span></label>
                            <input type="text" id="edit-tel" name="tel" maxlength="255" placeholder="+1 / +44 / WhatsApp number" required />
                        </div>
                        <div class="bb-field bb-field--full">
                            <label for="edit-message">Specifications &amp; Quantity <span class="bb-req">*</span></label>
                            <textarea id="edit-message" name="message" placeholder="Include desired dimensions, color, finish, destination port, and estimated square meters..." required></textarea>
                        </div>
                        <div class="bb-form-submit-row">
                            <button type="submit" id="edit-submit" class="bb-btn bb-btn-primary">Send Quote Inquiry</button>
                            <p id="quote-form-msg" class="bb-form-msg"></p>
                        </div>
                    </div>
                </form>
            </div>

            <aside class="bb-contact-card">
                <h3>Direct Factory Contact</h3>
                <p>Reach our export specialists in Anji directly for samples, datasheets, or factory visits.</p>

                <ul class="bb-contact-list">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
                        <div>
                            <strong>Telephone</strong>
                            <a href="tel:+8615005820528">+86 150 0582 0528</a>
                        </div>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2A9.94 9.94 0 0 0 3.3 16.8L2 22l5.33-1.39A9.95 9.95 0 1 0 12.04 2zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.48.13.65-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.07.13.07.73-.17 1.41z"/></svg>
                        <div>
                            <strong>WhatsApp</strong>
                            <a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer">+86 150 0582 0528</a>
                        </div>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
                        <div>
                            <strong>Email</strong>
                            <a href="mailto:info@bambooflooringchina.com">info@bambooflooringchina.com</a>
                        </div>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                        <div>
                            <strong>Factory Address</strong>
                            <span>Tangpu Industrial Zone, Anji, Zhejiang, China</span>
                        </div>
                    </li>
                </ul>

                <div class="bb-location-map">
                    <img src="/img/UploadFiles/factory-map.jpg" alt="Bothbest Bamboo Factory Location Map in Anji, China" loading="lazy" decoding="async" />
                </div>
            </aside>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. 自动填充来源产品名称
            var productInput = document.getElementById('edit-product');
            var urlProduct = new URLSearchParams(window.location.search).get('product');
            if (productInput) {
                if (urlProduct) {
                    productInput.value = urlProduct;
                } else if (document.referrer && document.referrer.indexOf('/products/') !== -1) {
                    productInput.value = document.referrer;
                }
            }

            // 2. 询盘表单提交
            var quoteForm = document.getElementById('contact-site-form');
            var quoteMsg = document.getElementById('quote-form-msg');
            if (quoteForm) {
                quoteForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var submitBtn = document.getElementById('edit-submit');
                    if (submitBtn) {
                        submitBtn.textContent = 'Sending...';
                        submitBtn.disabled = true;
                    }
                    fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        body: new FormData(quoteForm)
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success) {
                            quoteMsg.style.display = 'block';
                            quoteMsg.textContent = 'Thank you! Your inquiry has been sent successfully. We will respond within 24 hours.';
                            quoteForm.reset();
                        } else {
                            alert('Failed to send inquiry: ' + (data.message || 'Please try again.'));
                        }
                    })
                    .catch(function () {
                        alert('Network error, please try again later.');
                    })
                    .finally(function () {
                        if (submitBtn) {
                            submitBtn.textContent = 'Send Quote Inquiry';
                            submitBtn.disabled = false;
                        }
                    });
                });
            }

            // 3. Factory Tour 零跳动轻量轮播
            var slider = document.getElementById('factorySlider');
            if (slider) {
                var slides = slider.querySelectorAll('.bb-slide');
                var dots = slider.querySelectorAll('.bb-slider-dot');
                var captionEl = document.getElementById('factoryCaption');
                var counterEl = document.getElementById('factoryCounter');
                var current = 0;
                var timer = null;

                var showSlide = function (index) {
                    current = (index + slides.length) % slides.length;
                    for (var i = 0; i < slides.length; i++) {
                        slides[i].classList.toggle('is-active', i === current);
                        if (dots[i]) dots[i].classList.toggle('is-active', i === current);
                    }
                    if (captionEl) captionEl.textContent = slides[current].getAttribute('data-caption') || '';
                    if (counterEl) counterEl.textContent = (current + 1) + ' / ' + slides.length;
                };

                var startAuto = function () {
                    stopAuto();
                    timer = setInterval(function () { showSlide(current + 1); }, 4500);
                };
                var stopAuto = function () {
                    if (timer) { clearInterval(timer); timer = null; }
                };

                var prevBtn = document.getElementById('factoryPrev');
                var nextBtn = document.getElementById('factoryNext');
                if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); startAuto(); });
                if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); startAuto(); });
                for (var d = 0; d < dots.length; d++) {
                    dots[d].addEventListener('click', function () {
                        showSlide(parseInt(this.getAttribute('data-slide'), 10) || 0);
                        startAuto();
                    });
                }
                slider.addEventListener('mouseenter', stopAuto);
                slider.addEventListener('mouseleave', startAuto);
                startAuto();
            }
        });
    </script>
</BaseLayout>