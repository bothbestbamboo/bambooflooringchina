---
import BaseLayout from '../layouts/BaseLayout.astro';

const factorySlides = [
  { src: '/img/UploadFiles/null-p192tir36vdbs11u31jl01r0l1d101.jpg', alt: 'Bothbest bamboo flooring production line' },
  { src: '/img/UploadFiles/null-p192tiqdfpf798vp1nf6f761vfq1.jpg', alt: 'Bamboo strip pressing and lamination workshop' },
  { src: '/img/UploadFiles/null-p192tiq0goh2sgu01tnmqfbncp1.jpg', alt: 'Precision bamboo plank profiling machinery' },
  { src: '/img/UploadFiles/null-p192tipk50m2pkskdm0m41kkd1.jpg', alt: 'Automated bamboo flooring UV coating line' },
  { src: '/img/UploadFiles/null-p192tipa6imh112681v7rh4t11qm1.jpg', alt: 'Bamboo flooring quality inspection and sorting' },
  { src: '/img/UploadFiles/null-p192tiokaie4b1umk1oif136v11sj1.jpg', alt: 'Export-ready wholesale bamboo flooring warehouse' },
];
---
<BaseLayout
  title="About Bothbest | China Bamboo Flooring & Panels Factory"
  keywords="bamboo flooring factory, bamboo panels manufacturer, china bamboo wholesaler, Bothbest"
  description="Learn about Bothbest, an FSC-certified China factory manufacturing and exporting wholesale bamboo flooring, decking, and panels worldwide since 2001."
  bodyClass="html not-front not-logged-in one-sidebar sidebar-second page-contact"
  footerType="postscript"
  loadLegacyJs={false}
>
    <section class="container mainContent">
        <form action="/search.html" method="get" class="MobileSearch" role="search">
            <input type="text" name="SearchKeywords" id="MobileSearchKeywords" placeholder="Search bamboo..." aria-label="Search keywords" />
            <input type="submit" id="MobileSearch" name="search" value="Search" class="form-submit" />
        </form>
        <div class="row-fluid">
            <div class="content span9">
                <div class="innerSpacer">
                    <a id="main-content"></a>
                    <h1 class="title">About Us</h1>
                    <div class="AboutUs">
                        <p>Bothbest is a China-based manufacturer dedicated exclusively to rapidly renewable bamboo. We produce a comprehensive range of bamboo flooring, outdoor bamboo decking, bamboo panels, and architectural bamboo products.</p>
                        <p>Equipped with automated precision machinery, Bothbest is recognized as a reliable supplier and exporter across global bamboo markets. With more than 20 years of manufacturing experience and strict quality control, our products are trusted by importers, contractors, and end-users worldwide.</p>
                        <p>Our main facilities are located in China's core Moso bamboo region, where abundant bamboo forests are harvested sustainably on a rotating cycle. By combining selected Moso bamboo culms, low-VOC adhesives, and precision profiling, Bothbest supplies stable, wear-resistant products exported across Europe (Germany, France, Italy, UK, and more), the USA, and Australia.</p>
                        <p>Bothbest operates under ISO 9001 quality management and ISO 14001 environmental management standards.</p>
                    </div>

                    <h2 class="section-heading">Eco Mission</h2>
                    <p>Our mission is to manufacture durable, non-toxic, and ecologically sustainable bamboo building materials that deliver factory-direct value and dependable service to distributors, architects, builders, and homeowners.</p>
                    <p>By focusing exclusively on Moso bamboo utilization—maximizing bamboo yield while reducing hardwood logging—we actively support forest conservation and sustainable building practices.</p>

                    <h2 class="section-heading">Global Sales</h2>
                    <p>Since 2001, Bothbest has exported environmentally friendly bamboo building products to over 40 countries worldwide (highlighted in red below).</p>
                    <p><img src="/img/skin/map1.jpg" alt="Bothbest Global Bamboo Flooring Export Map" loading="lazy" decoding="async" /></p>
                    <p><strong>Europe:</strong> Germany, France, Italy, Spain, Portugal, Belgium, Netherlands, Denmark, Norway, Sweden, Switzerland, UK, Russia, Slovakia, Poland, Austria, Kosovo, Turkey</p>
                    <p><strong>North America:</strong> USA, Canada, Mexico</p>
                    <p><strong>Asia:</strong> South Korea, Japan, India, Sri Lanka, Maldives, Singapore, Philippines, Brunei, Malaysia, Saudi Arabia, UAE</p>
                    <p><strong>South America:</strong> Panama, Colombia, Brazil, Chile, Argentina</p>
                    <p><strong>Oceania:</strong> Australia, New Zealand</p>
                    <p><strong>Africa:</strong> South Africa, Nigeria, Morocco</p>

                    <h2 class="section-heading" id="RequestAQuote">Request A Quote</h2>
                    <div id="block-system-main" class="block block-system">
                        <form class="user-info-from-cookie contact-form" action="https://api.web3forms.com/submit" method="POST" id="contact-site-form" accept-charset="UTF-8">
                            <input type="hidden" name="access_key" value="81ff5088-e596-4b27-851b-cbaf5ab4a4f9" />
                            <input type="hidden" name="subject" value="New Product Quote Inquiry - Bothbest" />
                            <input type="hidden" name="from_name" value="Bothbest Quote Form" />
                            <div>
                                <div class="form-item form-type-textfield form-item-name">
                                    <label for="edit-name">Name <span class="form-required" title="This field is required.">*</span></label>
                                    <input type="text" id="edit-name" name="name" value="" size="60" maxlength="255" class="form-text required" required />
                                </div>
                                <div class="form-item form-type-textfield form-item-product">
                                    <label for="edit-product">Product <span class="form-required" title="This field is required.">*</span></label>
                                    <input type="text" id="edit-product" name="product" value="" size="60" maxlength="255" class="form-text required" required />
                                </div>
                                <div class="form-item form-type-textfield form-item-mail">
                                    <label for="edit-mail">E-mail <span class="form-required" title="This field is required.">*</span></label>
                                    <input type="email" id="edit-mail" name="email" value="" size="60" maxlength="255" class="form-text required" required />
                                </div>
                                <div class="form-item form-type-textfield form-item-mail">
                                    <label for="edit-tel">Tel / WhatsApp <span class="form-required" title="This field is required.">*</span></label>
                                    <input type="text" id="edit-tel" name="tel" value="" size="60" maxlength="255" class="form-text required" required />
                                </div>
                                <div class="clearfix"></div>
                                <div class="form-item form-type-textarea form-item-message">
                                    <label for="edit-message">Message <span class="form-required" title="This field is required.">*</span></label>
                                    <div class="form-textarea-wrapper resizable">
                                        <textarea id="edit-message" name="message" cols="60" rows="8" class="form-textarea required" required></textarea>
                                    </div>
                                </div>
                                <div class="form-actions form-wrapper" id="edit-actions">
                                    <input class="btn btn-success form-submit" type="submit" id="edit-submit" value="Send" />
                                </div>
                                <p id="quote-form-msg" style="display:none; font-weight:bold; margin-top:10px;"></p>
                            </div>
                        </form>
                    </div>

                    <div id="block-views-mentor-slider-block-1" class="block block-views AboutSlider">
                        <h2 class="section-heading">Factory Tour</h2>
                        <div class="hero-slider" id="factorySlider" aria-roledescription="carousel" aria-label="Bothbest Factory Tour">
                            <div class="hero-slides">
                                {factorySlides.map((slide, idx) => (
                                    <div class={`hero-slide${idx === 0 ? ' is-active' : ''}`}>
                                        <img
                                            src={slide.src}
                                            alt={slide.alt}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </div>
                                ))}
                            </div>
                            <button type="button" class="hero-nav hero-prev" id="factoryPrev" aria-label="Previous photo">&#8249;</button>
                            <button type="button" class="hero-nav hero-next" id="factoryNext" aria-label="Next photo">&#8250;</button>
                            <div class="hero-dots" id="factoryDots">
                                {factorySlides.map((_, idx) => (
                                    <button
                                        type="button"
                                        class={`hero-dot${idx === 0 ? ' is-active' : ''}`}
                                        data-slide={idx}
                                        aria-label={`View photo ${idx + 1}`}
                                    ></button>
                                ))}
                            </div>
                        </div>
                    </div>

                    <h2 class="section-heading">Location</h2>
                    <div class="innerSpacer MapPanel">
                        <div class="row-fluid gmapWrap">
                            <img src="/img/UploadFiles/factory-map.jpg" alt="Bothbest Bamboo Factory Location Map in Anji, China" loading="lazy" decoding="async" />
                        </div>
                    </div>
                </div>
            </div>

            <aside class="sidebar-second span3">
                <div id="block-block-5" class="block block-block widget_contact">
                    <section>
                        <h3>
                            <svg class="footer-svg-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#547834" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
                            Phone
                        </h3>
                        <div class="phone"><p><a href="tel:+8615005820528">+86 150 0582 0528</a></p></div>
                    </section>
                    <section>
                        <h3>
                            <svg class="footer-svg-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#547834" d="M12.04 2A9.94 9.94 0 0 0 3.3 16.8L2 22l5.33-1.39A9.95 9.95 0 1 0 12.04 2zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.48.13.65-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.07.13.07.73-.17 1.41z"/></svg>
                            WhatsApp
                        </h3>
                        <div class="email"><p><a href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer">+86 150 0582 0528</a></p></div>
                    </section>
                    <section>
                        <h3>
                            <svg class="footer-svg-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#547834" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                            Address
                        </h3>
                        <div class="address"><p>Tangpu Industrial Zone, Anji, Zhejiang, China</p></div>
                    </section>
                    <section>
                        <h3>
                            <svg class="footer-svg-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#547834" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
                            Email
                        </h3>
                        <div class="email"><p><a href="mailto:info@bambooflooringchina.com">info@bambooflooringchina.com</a></p></div>
                    </section>
                </div>
            </aside>
        </div>
    </section>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. 自动填充来源产品页
           var productInput = document.getElementById('edit-product');
var urlProduct = new URLSearchParams(window.location.search).get('product');
if (productInput) {
    productInput.value = urlProduct || document.referrer || '';
}

            // 2. 询盘表单提交
            var quoteForm = document.getElementById('contact-site-form');
            var quoteMsg = document.getElementById('quote-form-msg');
            if (quoteForm) {
                quoteForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var submitBtn = document.getElementById('edit-submit');
                    if (submitBtn) {
                        submitBtn.value = 'Sending...';
                        submitBtn.disabled = true;
                    }
                    var formData = new FormData(quoteForm);
                    fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        body: formData
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success) {
                            quoteMsg.style.display = 'block';
                            quoteMsg.style.color = '#468847';
                            quoteMsg.textContent = 'Thank you! Your inquiry has been sent successfully. We will contact you soon.';
                            quoteForm.reset();
                        } else {
                            alert('Failed to send inquiry: ' + (data.message || 'Please check your access_key.'));
                        }
                    })
                    .catch(function () {
                        alert('Network error, please try again later.');
                    })
                    .finally(function () {
                        if (submitBtn) {
                            submitBtn.value = 'Send';
                            submitBtn.disabled = false;
                        }
                    });
                });
            }

            // 3. Factory Tour 零跳动轻量轮播
            var slider = document.getElementById('factorySlider');
            if (slider) {
                var slides = slider.querySelectorAll('.hero-slide');
                var dots = slider.querySelectorAll('.hero-dot');
                var current = 0;
                var timer = null;

                var showSlide = function (index) {
                    current = (index + slides.length) % slides.length;
                    for (var i = 0; i < slides.length; i++) {
                        slides[i].classList.toggle('is-active', i === current);
                        if (dots[i]) dots[i].classList.toggle('is-active', i === current);
                    }
                };
                var startAuto = function () {
                    stopAuto();
                    timer = setInterval(function () { showSlide(current + 1); }, 4000);
                };
                var stopAuto = function () {
                    if (timer) { clearInterval(timer); timer = null; }
                };

                var prevBtn = document.getElementById('factoryPrev');
                var nextBtn = document.getElementById('factoryNext');
                if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); startAuto(); });
                if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); startAuto(); });
                for (var d = 0; d < dots.length; d++) {
                    dots[d].addEventListener('click', function () {
                        showSlide(parseInt(this.getAttribute('data-slide'), 10) || 0);
                        startAuto();
                    });
                }
                slider.addEventListener('mouseenter', stopAuto);
                slider.addEventListener('mouseleave', startAuto);
                startAuto();
            }
        });
    </script>
</BaseLayout>